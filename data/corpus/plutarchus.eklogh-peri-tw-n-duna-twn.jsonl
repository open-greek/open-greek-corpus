{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "28", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἠπειρώτῃ δίκτυα δίδως."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "29", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Πρὸς κωφοῖς ἀποπέρδεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "30", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἄνεμον διώκεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "31", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Παρὰ δικτύοις ὕδωρ κομίζεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "32", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἵππος εἰς λεῖον πεδίον."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "33", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἀετὸς εἰς θήραν."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "34", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ξυρὸς εἰς ἀκόνην."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "35", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Σφαῖρα κατὰ πρανοῦς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "36", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Πῦρ εἰς ἀκάνθας."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "37", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Σπόγγος εἰς ὕδωρ."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "38", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ὄρνιθος γάλα ζητεῖς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "39", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Φακοῦ γωνίαν κάμπτεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "40", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ὠὸν τίλλεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "41", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Θάλασσαν σπείρεις,"}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "42", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Πλίνθον πλύνεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "43", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Κωφῷ ὁμιλεῖς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "44", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Τυφλῷ διανεύεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "45", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἀνδριάντα γαργαλίζεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "46", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Εἰς τετρημένον πίθον ἀντλεῖς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "47", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἄστρα τοξεύεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "48", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Πῦρ ἀλείφεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "49", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Κατὰ μαχαιρῶν κυβιστᾷς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "50", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Κοσκίνῳ φέρεις ὕδωρ."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "51", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Νεφέλας ξαίνεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "52", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Αἰθίοπα λευκαίνεις."}
