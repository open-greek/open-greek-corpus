{"urn": "hymni-homerici.in-dioscuros", "edition": "perseus-grc2", "locus": "5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χαίρετε, Τυνδαρίδαι, ταχέων ἐπιβήτορες ἵππων."}
