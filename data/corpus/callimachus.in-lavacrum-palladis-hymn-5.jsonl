{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅσσαι λωτροχόοι τᾶς Παλλάδος ἔξιτε πᾶσαι,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔξιτε· τᾶν ἵππων ἄρτι φρυασσομενᾶν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τᾶν ἱερᾶν ἐσάκουσα, καὶ ἁ θεὸς εὔτυκος ἕρπειν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σοῦσθέ νυν, ὦ ξανθαί, σοῦσθε Πελασγιάδες."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὔποκʼ Ἀθαναία μεγάλως ἀπενίψατο πάχεις"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πρὶν κόνιν ἱππειᾶν ἐξελάσαι λαγόνων,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδʼ ὅκα δὴ λύθρῳ πεπαλαγμένα πάντα φέροισα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τεύχεα τῶν ἀδίκων ἦνθʼ ἀπὸ γηγενέων,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλὰ πολὺ πράτιστον ὑφʼ ἅρματος αὐχένας ἵππων"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λυσαμένα παγαῖς ἔκλυσεν Ὠκεανῶ"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἱδρῶ καὶ ῥαθάμιγγας, ἐφοίβασεν δὲ παγέντα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πάντα χαλινοφάγων ἀφρὸν ἀπὸ στομάτων."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὦ ἴτʼ Ἀχαιιάδες, καὶ μὴ μύρα μηδʼ ἀλαβάστρως"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "συρίγγων ἀίω φθόγγον ὑπαξονίων ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μὴ μύρα λωτροχόοι τᾷ Παλλάδι μηδʼ ἀλαβάστρως"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "(οὐ γὰρ Ἀθαναία χρίματα μεικτὰ φιλεῖ)"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἴσετε μηδὲ κάτοπτρον· ἀεὶ καλὸν ὄμμα τὸ τήνας"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "18", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδʼ ὅκα τὰν Ἴδᾳ Φρὺξ ἐδίκαζεν ἔριν,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "19", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὔτʼ ἐς ὀρείχαλκον μεγάλα θεὸς οὔτε Σιμοῦντος"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "20", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔβλεψεν δίναν ἐς διαφαινομέναν·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "21", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδʼ Ἥρα· Κύπρις δὲ διαυγέα χαλκὸν ἑλοῖσα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "22", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλάκι τὰν αὐτὰν δὶς μετέθηκε κόμαν·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "23", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁ δέ, δὶς ἑξήκοντα διαθρέξασα διαύλως,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "24", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἷα παρʼ Εὐρώτᾳ τοὶ Λακεδαιμόνιοι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "25", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀστέρες, ἐμπεράμως ἐνετρίψατο λιτὰ λαβοῖσα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "26", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χρίματα, τᾶς ἰδίας ἔκγονα φυταλιᾶς·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "27", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὦ κῶραι, τὸ δʼ ἔρευθος ἀνέδραμε, πρώιον οἵαν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "28", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ ῥόδον ἢ σίβδας κόκκος ἔχει χροΐαν."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "29", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῶ καὶ νῦν ἄρσεν τι κομίξατε μῶνον ἔλαιον,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "30", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ᾧ Κάστωρ, ᾧ καὶ χρίεται Ἡρακλέης·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "31", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἴσετε καὶ κτένα οἱ παγχρύσεον, ὡς ἀπὸ χαίταν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "32", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πέξηται, λιπαρὸν σμασαμένα πλόκαμον."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "33", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔξιθʼ Ἀθαναία· πάρα τοι καταθύμιος ἴλα,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "34", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παρθενικαὶ μεγάλων παῖδες Ἀκεστοριδᾶν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "35", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὠθάνα, φέρεται δὲ καὶ ἁ Διομήδεος ἀσπίς,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "36", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς ἔθος Ἀργείων τοῦτο παλαιότερον"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "37", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Εὐμήδης ἐδίδαξε, τεὶν κεχαρισμένος ἱρεύς·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "38", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅς ποκα βωλευτὸν γνοὺς ἐπί οἱ θάνατον"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "39", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δᾶμον ἑτοιμάζοντα φυγᾷ τεὸν ἱρὸν ἄγαλμα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "40", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ᾤχετʼ ἔχων, Κρεῖον δʼ εἰς ὄρος ᾠκίσατο·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "41", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κρεῖον ὄρος· σὲ δέ, δαῖμον, ἀπορρώγεσσιν ἔθηκεν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "42", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐν πέτραις, αἷς νῦν οὔνομα Παλλατίδες·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "43", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔξιθʼ Ἀθαναία περσέπτολι, χρυσεοπήληξ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "44", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἵππων καὶ σακέων ἁδομένα πατάγῳ."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "45", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σάμερον ὑδροφόροι μὴ βάπτετε—σάμερον Ἄργος"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "46", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πίνετʼ ἀπὸ κρανᾶν μηδʼ ἀπὸ τῶ ποταμῶ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "47", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σάμερον αἱ δῶλαι τὰς κάλπιδας ἢ ᾽ς Φυσάδειαν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "48", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ ἐς Ἀμυμώναν οἴσετε τὰν Δαναῶ."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "49", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ γὰρ δὴ χρυδῷ τε καὶ ἄνθεσιν ὕδατα μίξας"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "50", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἡξεῖ φορβαίων Ἴναχος ἐξ ὀρέων"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "51", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τἀθάνᾳ τὸ λοετρὸν ἄγων καλόν. ἀλλά, Πελασγέ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "52", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φράζεο μὴ οὐκ ἐθέλων τὰν βασίλειαν ἴδῃς."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "53", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅς κεν ἴδῃ γυμνὰν τὰν Παλλάδα τὰν πολιοῦχον,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "54", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὦργος ἐσοψεῖται τοῦτο πανυστάτιον."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "55", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πότνἰ Ἀθαναία τὺ μὲν ἔξιθι· μέσφα δʼ ἐγώ τι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "56", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ταῖσδʼ ἐρέω. μῦθος δʼ οὐκ ἐμός, ἀλλʼ ἑτέρων."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "57", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παῖδες, Ἀθαναία νύμφαν μίαν ἔν ποκα Θήβαις"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "58", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πουλύ τι καὶ περὶ δὴ φίλατο τᾶν ἑταρᾶν,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "59", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ματέρα Τειρεσίαο, καὶ οὔποκα χωρὶς ἔγεντο·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "60", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλὰ καὶ ἀρχαίων εὖτʼ ἐπὶ Θεσπιέων"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "61", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ ʼπὶ Κορωνείας ἢ εἰς Ἁλίαρτον ἐλαύνοι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "62", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἵππως, Βοιωτῶν ἔργα διερχομένα,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "63", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ ʼπὶ Κορωνείας, ἵνα οἱ τεθυωμένον ἄλσος"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "64", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ βωμοὶ ποταμῷ κεῖντʼ ἐπὶ Κωραλίῳ·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "65", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλάκις ἁ δαίμων νιν ἑῶ ἐπεβάσατο δίφρω,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "66", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδʼ ὄαροι νυμφᾶν οὐδὲ χοροστασίαι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "67", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁδεῖαι τελέθεσκον, ὅκʼ οὐχ ἁγεῖτο Χαρικλώ·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "68", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλʼ ἔτι καὶ τήναν δάκρυα πόλλʼ ἔμενεν,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "69", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καίπερ Ἀθαναίᾳ καταθύμιον ἔσσαν ἑταίραν."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "70", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δή ποκα γὰρ πέπλων λυσαμένα περόνας"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "71", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἵππω ἐπὶ κράνᾳ Ἑλικωνίδι καλὰ ῥεοίσᾳ"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "72", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λῶντο· μεσαμβρινὰ δʼ εἶχʼ ὄρος ἁσυχία."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "73", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀμφότεραι λώοντο, μεσαμβριναὶ δʼ ἔσαν ὧραι,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "74", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλὰ δʼ ἁσυχία τῆνο κατεῖχεν ὄρος."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "75", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Τειρεσίας δʼ ἔτι μῶνος ἁμᾶ κυσὶν ἄρτι γένεια"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "76", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "περκάζων ἱερὸν χῶρον ἀνεστρέφετο·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "77", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "διψάσας δʼ ἄφατόν τι ποτὶ ῥόον ἤλυθε κράνας,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "78", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σχέτλιος· οὐκ ἐθέλων δʼ εἶδε τὰ μὴ θεμιτά·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "79", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸν δὲ χολωσαμένα περ ὅμως προσέφασεν Ἀθάνα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "80", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τίς σε, τὸν ὀφθαλμὼς οὐκέτʼ ἀποισόμενον,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "81", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὦ Εὐηρείδα, χαλεπὰν ὁδὸν ἄγαγε δαίμων;"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "82", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁ μὲν ἔφα, παιδὸς δʼ ὄμματα νὺξ ἔλαβεν."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "83", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἑστάκη δʼ ἄφθογγος, ἐκόλλασαν γὰρ ἀνῖαι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "84", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γώνατα καὶ φωνὰν ἔσχεν ἀμηχανία."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "85", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁ νύμφα δʼ ἐβόασε τί μοι τὸν κῶρον ἔρεξας,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "86", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πότνια; τοιαῦται δαίμονες ἐστὲ φίλαι;"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "87", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὄμματά μοι τῶ παιδὸς ἀφείλεο. τέκνον ἄλαστε,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "88", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἶδες Ἀθαναίας στήθεα καὶ λαγόνας,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "89", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλʼ οὐκ ἀέλιον πάλιν ὄψεαι. ὦ ἐμὲ δειλάν,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "90", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὦ ὄρος, ὦ Ἑλικὼν οὐκέτι μοι παριτέ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "91", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἦ μεγάλʼ ἀντʼ ὀλίγων ἐπράξαο· δόρκας ὀλέσσας"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "92", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ πρόκας οὐ πολλὰς φάεα παιδὸς ἔχεις."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "93", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἆ καὶ ἅμʼ ἀμφοτέραισι φίλον περὶ παῖδα λαβοῖσα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "94", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μάτηρ μὲν γοερᾶν οἶτον ἀηδονίδων"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "95", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἆγε βαρὺ κλαίοισα, θεὰ δʼ ἐλέησεν ἑταίραν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "96", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καί νιν Ἀθαναία πρὸς τόδʼ ἔλεξεν ἔπος"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "97", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δῖα γύναι, μετὰ πάντα βαλεῦ πάλιν ὅσσα διʼ ὀργὰν"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "98", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἶπας· ἐγὼ δʼ οὔ τοι τέκνον ἔθηκʼ ἀλαόν."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "99", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐ γὰρ Ἀθαναίᾳ γλυκερὸν πέλει ὄμματα παίδων"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "100", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁρπάζειν· Κρόνιοι δʼ ὧδε λέγοντι νόμοι·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "101", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅς κε τινʼ ἀθανάτων, ὅκα μὴ θεὸς αὐτὸς ἕληται,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "102", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀθρήσῃ, μισθῶ τοῦτον ἰδεῖν μεγάλω."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "103", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δῖα γύναι, τὸ μὲν οὐ παλινάγρετον αὖθι γένοιτο"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "104", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔργον· ἐπεὶ μοιρᾶν ὧδʼ ἐπένησε λίνα,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "105", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁνίκα τὸ πρᾶτόν νιν ἐγείναο· νῦν δὲ κομίζευ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "106", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὦ Εὐηρείδα, τέλθος ὀφειλόμενον."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "107", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πόσσα μὲν ἁ Καδμηὶς ἐς ὕστερον ἔμπυρα καυσεῖ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "108", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τόσσα δʼ Ἀρισταῖος, τὸν μόνον εὐχόμενοι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "109", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παῖδα, τὸν ἁβατὰν Ἀκταίονα, τυφλὸν ἰδέσθαι."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "110", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τῆνος μεγάλας σύνδρομος Ἀρτέμιδος"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "111", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐσσεῖτʼ· ἀλλʼ οὐκ αὐτὸν ὅ τε δρόμος αἵ τʼ ἐν ὄρεσσι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "112", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ῥυσεῦνται ξυναὶ τᾶμος ἑκαβολίαι,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "113", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὁππόκʼ ἂν οὐκ ἐθέλων περ ἴδῃ χαρίεντα λοετρὰ"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "114", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δαίμονος· ἀλλʼ αὐταὶ τὸν πρὶν ἄνακτα κύνες"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "115", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τουτάκι δειπνησεῦντι· τὰ δʼ υἱέος ὀστέα μάτηρ"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "116", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λεξεῖται δρυμὼς πάωτας ἐπερχομένα·"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "117", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὀλβίσταν ἐρέει σε καὶ εὐαίωνα γενέσθαι,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "118", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐξ ὀρέων ἀλαὸν παῖδʼ ὑποδεξαμέναν."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "119", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὦ ἑτάρα, τῶ μή τι μινύρεο· τῷδε γὰρ ἄλλα"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "120", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τεῦ χάριν ἐξ ἐμέθεν πολλὰ μενεῦντι γέρα."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "121", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μάντιν ἐπεὶ θησῶ νιν ἀοίδιμον ἐσσομένοισιν,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "122", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἦ μέγα τῶν ἄλλων δή τι περισσότερον."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "123", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γνωσεῖται δʼ ὄρνιχας, ὅς αἴσιος οἵ τε πέτονται"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "124", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἤλιθα καὶ ποίων οὐκ ἀγαθαὶ πτέρυγες."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "125", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλὰ δὲ Βοιωτοῖσι θεοπρόπα, πολλὰ δὲ Κάδμῳ"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "126", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χρησεῖ, καὶ μεγάλοις ὕστερα Λαβδακίδαις."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "127", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δωσῶ καὶ μέγα βάκτρον, ὅ οἱ πόδας ἐς δέον ἀξεῖ,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "128", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δωσῶ καὶ βιότω τέρμα πολυχρόνιον."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "129", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ μόνος, εὖτε θάνῃ, πεπνυμένος ἐν νεκύεσσι"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "130", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φοιτασεῖ, μεγάλωι τίμιος Ἁγεσίλᾳ."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "131", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὥς φαμένα κατένευσε· τὸ δʼ ἐντελὲς ᾧ κʼ ἔπι νεύσῃ"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "132", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Παλλάς, ἐπεὶ μώνᾳ Ζεὺς τό γε θυγατέρων"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "133", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δῶκεν Ἀθαναίᾳ, πατρώια πάντα φέρεσθαι,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "134", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λωτροχόοι, μάτηρ δʼ οὔτις ἔτικτε θεάν,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "135", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλὰ Διὸς κορυφά. κορυφὰ Διὸς οὐκ ἐπινεύει"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "136", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ψεύδεα κοὐδὲ Διὸς ψεύδετ αι ἁ θυγάτηρ."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "137", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔρχετʼ Ἀθαναία νῦν ἀτρεκές· ἀλλὰ δέχεσθε"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "138", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὰν θεόν, ὦ κῶραι τὦργον ὅσαις μέλεται,"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "139", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σύν τʼ εὐαγορίᾳ σύν τʼ εὔγμασι σύν τʼ ὀλολυγαῖς."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "140", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χαῖρε θεά, κάδευ δʼ Ἄργεος Ἰναχίω."}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "141", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χαῖρε καὶ ἐξελάοισα, καὶ ἐς πάλιν αὖτις ἐλάσσαις"}
{"urn": "callimachus.in-lavacrum-palladis-hymn-5", "edition": "perseus-grc3", "locus": "142", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἵππως, καὶ Δαναῶν κλᾶρον ἅπαντα σάω."}
