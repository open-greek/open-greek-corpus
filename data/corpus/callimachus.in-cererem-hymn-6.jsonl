{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῶ καλάθω κατιόντος ἐπιφθέγξασθε, γυναῖκες,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Δάματερ μέγα χαῖρε πολυτρόφε πουλυμέδιμνε."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸν κάλαθον κατιόντα χαμαὶ θασεῖσθε βέβαλοι,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μηδʼ ἀπὸ τῶ τέγεος μηδʼ ὑψόθεν αὐγάσσησθε"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μὴ παῖς μηδὲ γυνὰ μηδʼ ἃ κατεχεύατο χαίταν,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μηδʼ ὅκʼ ἀφʼ αὑαλέων στομάτων πτύωμες ἄπαστοι."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἕσπερος ἐκ νεφέων ἐσκέψατο πανίκα νεῖται,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἕσπερος, ὅστε πιεῖν Δαμάτερα μῶνος ἔπεισεν,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁρπαγίμας ὅκʼ ἄπυστα μετέστιχεν ἴχνια κώρας."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πότνια, πῶς σε δύναντο πόδες φέρεν ἔστʼ ἐπὶ δυθμάς,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔστʼ ἐπὶ τὼς μέλανας καὶ ὅπα τὰ χρύσεα μᾶλα;"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐ πίες οὔτʼ ἄρʼ ἔδες τῆνον χρόνον οὐδὲ λοέσσα."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τρὶς μὲν δὴ διέβας Ἀχελώιον ἀργυροδίναν,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοσσάκι δʼ ἀενάων ποταμῶν ἐπέρασας ἕκαστον,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τρὶς δʼ ἐπὶ Καλλιχόρῳ χαμάδις ἐκαθίσσαο φρητί"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐσταλέα ἄποτός τε καὶ οὐ φάγες οὐδὲ λοέσσα."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μὴ μὴ ταῦτα λέγωμες ἃ δάκρυον ἄγαγε Δηοῖ·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "18", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κάλλιον, ὡς πολίεσσιν ἑαδότα τέθμια δῶκε·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "19", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κάλλιον, ὡς καλάμαν τε καὶ ἱερὰ δράγματα πράτα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "20", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀσταχύων ἀπέκοψε καὶ ἐν βόας ἧκε πατῆσαι,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "21", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁνίκα Τριπτόλεμος ἀγαθὰν ἐδιδάσκετο τέχναν·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "22", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κάλλιον, ὡς, ἵνα καί τις ὑπερβασίας ἀλέηται,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "23", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "π ἰδέσθαι"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "24", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὔπω τὰν Κνιδίαν, ἔτι Δώτιον ἱρὸν ἔναιον,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "25", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὶν δʼ αὐτᾷ καλὸν ἄλσος ἐποιήσαντο Πελασγοὶ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "26", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δένδρεσιν ἀμφιλαές· διά κεν μόλις ἦνθεν ὀιστός·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "27", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐν πίτυς, ἐν μεγάλαι πτελέαι ἔσαν, ἐν δὲ καὶ ὄχναι,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "28", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐν δὲ καλὰ γλυκύμαλα· τὸ δʼ ὥστʼ ἀλέκτρινον ὕδωρ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "29", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐξ ἀμαρᾶν ἀνέθυε. θεὰ δʼ ἐπεμαίνετο χώρῳ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "30", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅσσον Ἐλευσῖνι, Τριόπῳ θʼ ὅσον, ὁκκόσον Ἔννᾳ."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "31", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλʼ ὅκα Τριοπίδαισιν ὁ δεξιὸς ἄχθετο δαίμων,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "32", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τουτάκις ἁ χείρων Ἐρυσίχθονος ἅψατο βωλά·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "33", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σεύατʼ ἔχων θεράποντας ἐείκοσι, πάντας ἐν ἀκμᾷ,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "34", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πάντας δʼ ἀνδρογίγαντας ὅλαν πόλιν ἀρκίος ἆραι,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "35", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀμφότερον πελέκεσσι καὶ ἀξίναισιν ὁπλίσσας,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "36", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐς δὲ τὸ Δάματρος ἀναιδέες ἔδραμον ἄλσος."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "37", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἦς δέ τις αἴγειρος, μέγα δένδρεον αἰθέρι κῦρον,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "38", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῷ δʼ ἔπι ταὶ νύμφαι ποτὶ τὤνδιον ἑψιόωντο,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "39", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἃ πράτα πλαγεῖσα κακὸν μέλος ἴαχεν ἄλλαις."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "40", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ᾄσθετο Δαμάτηρ, ὅτι οἱ ξύλον ἱερὸν ἄλγει,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "41", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἶπε δὲ χωσαμένα \"τίς μοι καλὰ δένδρεα κόπτει;\""}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "42", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτίκα Νικίππᾳ, τάν οἱ πόλις ἀράτειραν"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "43", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δαμοσίαν ἔστασαν, ἐείσατο, γέντο δὲ χειρὶ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "44", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "στέμματα καὶ μάκωνα, κατωμαδίαν δʼ ἔχε κλᾷδα."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "45", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φᾶ δὲ παραψύχοισα κακὸν καὶ ἀναιδέα φῶτα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "46", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τέκνον, ὅτις τὰ θεοῖσιν ἀνειμένα δένδρεα κόπτεις,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "47", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τέκνον ἐλίνυσον, τέκνον πολύθεστε τοκεῦσι,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "48", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παύεο καὶ θεράποντας ἀπότρεπε, μή τι χαλεφθῇ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "49", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πότνια Δαμάτηρ, τᾶς ἱερὸν ἐκκεραΐζεις."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "50", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὰν δʼ ἄρʼ ὑποβλέψας χαλεπώτερον ἠὲ κυναγὸν"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "51", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὤρεσιν ἐν Τμαρίοισιν ὑποβλέπει ἄνδρα λέαινα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "52", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὠμοτόκος, τᾶς φαντὶ πέλειν βλοσυρώτατον ὄμμα,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "53", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χάζευ, ἔφα, μή τοι πέλεκυν μέγαν ἐν χροΐ πάξω."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "54", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ταῦτα δʼ ἐμὸν θησεῖ στεγανὸν δόμον, ᾧ ἔνι δαῖτας"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "55", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰὲν ἐμοῖς ἑτάροισιν ἄδην θυμαρέας ἀξῶ."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "56", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἶπεν ὁ παῖς, Νέμεσις δὲ κακὰν ἐγράψατο φωνάν."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "57", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Δαμάτηρ δʼ ἄφατόν τι κοτέσσατο, γείνατο δʼ ἁ θεύς·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "58", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἴθματα μὲν χέρσω, κεφαλὰ δέ οἱ ἅψατʼ Ὀλύμπω."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "59", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἱ μὲν ἄρʼ ἡμιθνῆτες, ἐπεὶ τὰν πότνιαν εἶδον,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "60", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐξαπίνας ἀπόρουσαν ἐνὶ δρυσὶ χαλκὸν ἀφέντες·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "61", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁ δʼ ἄλλως μὲν ἔασεν, ἀναγκαίᾳ γὰρ ἕποντο"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "62", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δεσποτικὰν ὑπὸ χεῖρα, βαρὺν δʼ ἀπαμείψατʼ ἄνακτα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "63", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ναὶ ναί, τεύχεο δῶμα, κύον, κύον, ᾧ ἔνι δαῖτας"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "64", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ποιησεῖς· θαμιναὶ γάρ ἐς ὕστερον εἰλαπίναι τοι."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "65", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁ μὲν τόσσʼ εἰποῖσʼ Ἐρυσίχθονι τεῦχε πονηρά."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "66", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτίκα οἱ χαλεπόν τε καὶ ἄγριον ἔμβαλε λιμὸν"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "67", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἴθωνα κρατερόν, μεγάλᾳ δʼ ἐστρεύγετο νούσῳ."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "68", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σχέτλιος, ὅσσα πάσαιτο τόσων ἔχεν ἵμερος αὖτις."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "69", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἴκατι δαῖτα πένοντο, δυώδεκα δʼ οἶνον ἄφυσσον·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "70", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τόσσα Διώνυσον γὰρ ἃ καὶ Δάματρα χαλέπτελ·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "71", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ γὰρ τᾷ Δάματρι συνωργίσθη Διόνυσος."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "72", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὔτε νιν εἰς ἐράνως οὔτε ξυνδείπνια πέμπον"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "73", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰδόμενοι γονέες, προχανὰ δʼ εὑρίσκετο πᾶσα."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "74", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἦνθον Ἰτωνιάδος νιν Ἀθαναίας ἐπʼ ἄεθλα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "75", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ὀρμενίδαι καλέοντες· ἀπʼ ὦν ἀρνήσατο μάτηρ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "76", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐκ ἔνδοι, χθιζὸς γὰρ ἐπὶ Κραννῶνα βέβακε"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "77", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τέλθος ἀπαιτησῶν ἑκατὸν βόας. ἦνθε Πολυξώ,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "78", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μάτηρ Ἀκτορίωνος, ἐπεὶ γάμον ἄρτυε παιδί,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "79", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀμφότερον Τριόπαν τε καὶ υἱέα κικλήσκοισα."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "80", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὰν δὲ γυνὰ βαρύθυμος ἀμείβετο δάκρυ χέοισα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "81", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νεῖταί τοι Τριόπας, Ἐρυσίχθονα δʼ ἤλασε κάπρος"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "82", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Πίνδον ἀνʼ εὐάγκειαν, ὁ δʼ ἐννέα φάεα κεῖται."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "83", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δειλαία φιλότεκνε, τί δʼ οὐκ ἐψεύσαο, μᾶτερ;"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "84", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δαίνυεν εἰλαπίναν τις· ἐν ἀλλοτρίοις Ἐρυσίχθων."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "85", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄγετό τις νύμφαν· Ἐρυσίχθονα δίσκος ἔτυψεν,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "86", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ ἔπεσʼ ἐξ ἵππων, ἢ ἐν Ὄθρυϊποίμνἰ ἀμιθρεῖ."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "87", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐνδόμυχος δἤπειτα πανάμερος εἰλαπιναστὰς"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "88", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἤσθιε μυρία πάντα· κακὰ δʼ ἐξάλλετο γαστὴρ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "89", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰεὶ μᾶλλον ἔδοντι, τὰ δʼ ἐς βυθὸν οἷα θαλάσσας"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "90", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλεμάτως ἀχάριστα κατέρρεεν εἴδατα πάντα."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "91", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς δὲ Μίμαντι χιών, ὡς ἀελίῳ ἔνι πλαγγών,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "92", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τούτων ἔτι μεῖζον ἐτάκετο μέσφʼ ἐπὶ νευράς·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "93", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δειλαίῳ ἶνές τε καὶ ὀστέα μῶνον ἔλειφθεν."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "94", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κλαῖε μὲν ἁ μάτηρ, βαρὺ δʼ ἔστενον αἱ δύʼ ἀδελφαὶ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "95", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χὡ μαστὸς τὸν ἔπωνε καὶ αἱ δέκα πολλάκι δῶλαι."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "96", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ δʼ αὐτὸς Τριόπας πολιαῖς ἐπὶ χεῖρας ἔβαλλε,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "97", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῖα τὸν οὐκ ἀίοντα Ποσειδάωνα καλιστρέων·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "98", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ψευδοπάτωρ ἰδὲ τόνδε τεοῦ τρίτον, εἴπερ ἐγὼ μὲν"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "99", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σεῦ τε καὶ Αἰολίδος Κανάκας γένος, αὐτὰρ ἐμεῖο"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "100", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῦτο τὸ δείλαιον γένετο βρέφος· αἴθε γὰρ αὐτὸν"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "101", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "βλητὸν ὑπʼ Ἀπόλλωνος ἐμαὶ χέρες ἐκτερέιξαν·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "102", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νῦν δὲ κακὰ βούβρωστις ἐν ὀφθαλμοῖσι κάθηται."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "103", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἤ οἱ ἀπόστασον χαλεπὰν νόσον ἠέ νιν αὐτὸς"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "104", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "βόσκε λαβών· ἁμαὶ γὰρ ἀπειρήκαντι τράπεζαι."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "105", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χῆραι μὲν μάνδραι, κενεαὶ δέ μοι αὔλιες ἤδη"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "106", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τετραπόδων, ἤδη γὰρ ἀπαρνήσαντο μάγειροι."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "107", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλὰ καὶ οὐρῆας μεγαλᾶν ὑπέλυσαν ἁμαξᾶν,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "108", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τὰν βῶν ἔφαγεν, τὰν Ἑστίᾳ ἔτρεφε μάτηρ,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "109", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τὰν ἀεθλοφόρον καὶ τὸν πολεμήιον ἵππον,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "110", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τὰν αἴλουρον, τὰν ἔτρεμε θηρία μικκά."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "111", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μέσφʼ ὅκα μὲν Τριόπαο δόμοις ἔνι χρήματα κεῖτο,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "112", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μῶνοι ἄρʼ οἰκεῖοι θάλαμοι κακὸν ἠπίσταντο."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "113", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλʼ ὅκα τὸν βαθὺν οἶκον ἀνεξήραναν ὀδόντες,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "114", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τόχʼ ὁ τῶ βασιλῆος ἐνὶ τριόδοισι καθῆστο"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "115", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰτίζων ἀκόλως τε καὶ ἔκβολα λύματα δαιτός."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "116", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Δάματερ, μὴ τῆνος ἐμὶν φίλος, ὅς τοι ἀπεχθής,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "117", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἴη μηδʼ ὁμότοιχος· ἐμοὶ κακογείτονες ἐχθροί."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "118", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ᾄσατε παρθενικαί, καὶ ἐπιφθέγξασθε τεκοῖσαι"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "119", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Δάματερ μέγα χαῖρε πολυτρόφε πουλυμέδιμνε."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "120", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χὠς αἱ τὸν κάλαθον λευκότριχες ἵπποι ἄγοντι"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "121", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τέσσαρες, ὣς ἁμὶν μεγάλα θεὸς εὐρυάνασσα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "122", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λευκὸν ἔαρ, λευκὸν δὲ θέρος καὶ χεῖμα φέροισα"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "123", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἡξεῖ καὶ φθινόπωρον, ἔτος δʼ εἰς ἄλλο φυλαξεῖ."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "124", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς δʼ ἀπεδίλωτοι καὶ ἀνάμπυκες ἄστυ πατεῦμες,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "125", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὣς πόδας, ὣς κεφαλὰς παναπηρέας ἕξομες αἰεί."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "126", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς δʼ αἱ λικνοφόροι χρυσῶ πλέα λίκνα φέροντι,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "127", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὣς ἁμὲς τὸν χρυσὸν ἀφειδέα πασαίμεσθα."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "128", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μέσφα τὰ τᾶς πόλιος πρυτανήια τὰς ἀτελέστως,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "129", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὰς δὲ τελεσφορέας ποτὶ τὰν θεὸν ἄχρις ὁμαρτεῖν,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "130", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἵτινες ἑξήκοντα κατώτεραι· αἱ δὲ βαρεῖαι"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "131", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χἄτις Ἐλειθυίᾳ τείνει χέρα χἄτις ἐν ἄλγει."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "132", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὣς ἅλις, ὡς αὐτᾶν ἱκανὸν γόνυ· ταῖσι δὲ Δηὼ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "133", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δωσεῖ πάντʼ ἐπίμεστα καὶ ὡς ποτὶ ναὸν ἵκωνται."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "134", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χαῖρε θεὰ καὶ τάνδε σάω πόλιν ἔν θʼ ὁμονοίᾳ"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "135", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔν τʼ εὐηπελίᾳ, φέρε δʼ ἀγρόθι νόστιμα πάντα·"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "136", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φέρβε βόας, φέρε μᾶλα, φέρε στάχυν, οἶσε θερισμόν,"}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "137", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φέρβε καὶ εἰράναν, ἵνʼ ὃς ἄροσε τῆνος ἀμάσῃ."}
{"urn": "callimachus.in-cererem-hymn-6", "edition": "perseus-grc3", "locus": "138", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἵλαθί μοι τρίλλιστε μέγα κρείοισα θεάων."}
