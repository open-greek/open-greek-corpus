{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Αἴλινά μοι στοναχεῖτε νάπαι καὶ Δώριον ὕδωρ,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ ποταμοὶ κλαίοιτε τὸν ἱμερόεντα Βίωνα."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νῦν φυτά μοι μύρεσθε, καὶ ἄλσεα νῦν γοάοισθε,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄνθεα νῦν στυμνοῖσιν ἀποπνείοιτε κορύμβοις,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νῦν ῥόδα φοινίσσεσθε τὰ πένθιμα, νῦν ἀνεμῶναι,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νῦν ὑάκινθε λάλει τὰ σὰ γράμματα καὶ πλέον αἰαῖ"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "βάμβανε τοῖς πετάλοισι· καλὸς τέθνακε μελικτάς."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀδόνες αἱ πυκινοῖσιν ὀδυρόμεναι ποτὶ φύλλοις,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νάμασι τοῖς Σικελοῖς ἀγγείλατε τᾶς Ἀρεθοίσας,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅττι Βίων τέθνακεν ὁ βουκόλος, ὅττι σὺν αὐτῷ"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τὸ μέλος τέθνακε καὶ ὤλετο Δωρὶς ἀοιδά."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Στρυμόνιοι μύρεσθε παρ’ ὕδασιν αἴλινα κύκνοι,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ γοεροῖς στομάτεσσι μελίσδετε πένθιμον ᾠδάν,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἵαν ὑμετέροις ποτὶ χείλεσι γῆρας ἀείδει,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἴπατε δ’ αὖ κούραις Οἰαγρίσιν, εἴπατε πάσαις"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "18", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Βιστονίαις Νύμφαισιν ἀπώλετο Δώριος Ὀρφεύς."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "19", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "20", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κεῖνος ὁ ταῖς ἀγέλαισιν ἐράσμιος οὐκέτι μέλπει,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "21", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐκέτ’ ἐρημαίαισιν ὑπὸ δρυσὶν ἥμενος ᾅδει,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "22", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλὰ παρὰ Πλουτῆϊ μέλος Ληθαῖον ἀείδει."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "23", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὤρεα δ’ ἐστὶν ἄφωνα, καὶ αἱ βόες αἱ ποτὶ ταύροις"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "24", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πλαζόμεναι γοάοντι καὶ οὐκ ἐθέλοντι νέμεσθαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "25", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "26", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σεῖο Βίων ἔκλαυσε ταχὺν μόρον αὐτὸς Ἀπόλλων,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "27", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ Σάτυροι μύροντο μελάγχλαινοί τε Πρίηποι·"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "28", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ Πᾶνες στοναχεῦντο τὸ σὸν μέλος, αἵ τε καθ’ ὕλαν"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "29", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Κρανίδες ὠδύραντο, καὶ ὕδατα δάκρυα γέντο."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "30", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἀχὼ δ’ ἐν πέτραισιν ὀδύρεται, ὅττι σιωπῇ"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "31", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κοὐκέτι μιμεῖται τὰ σὰ χείλεα. σῷ δ’ ἐπ’ ὀλέθρῳ"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "32", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δένδρεα καρπὸν ἔριψε, τὰ δ’ ἄνθεα πάντ’ ἐμαράνθη."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "33", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μάλων οὐκ ἔρρευσε καλὸν γλάγος, οὐ μέλι σίμβλων,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "34", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κάτθανε δ’ ἐν κηρῷ λυπεύμενον· οὐκέτι γὰρ δεῖ"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "35", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῶ μέλιτος τῶ σῶ τεθνακότος αὐτὸ τρυγᾶσθαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "36", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "37", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐ τόσον εἰναλίαισι παρ’ ᾀόσι μύρατο Σειρήν,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "38", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδὲ τόσον ποκ’ ἄεισεν ἐνὶ σκοπέλοισιν Ἀηδών,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "39", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδὲ τόσον θρήνησεν ἀν’ ὤρεα μακρὰ Χελιδών,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "40", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἀλκυόνος δ’ οὐ τόσσον ἐπ’ ἄλγεσιν ἴαχε Κῆϋξ,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "42", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδὲ τόσον γλαυκοῖς ἐνὶ κύμασι κηρύλος ᾆδεν,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "41", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐ τόσον ἀῴοισιν ἐν ἄγκεσι παῖδα τὸν Ἀοῦς"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "43", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἱπτάμενος περὶ σᾶμα κινύρατο Μέμνονος ὄρνις,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "44", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅσσον ἀποφθιμένοιο κατωδύραντο Βίωνος."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "45", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "46", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀδονίδες πᾶσαί τε χελιδόνες, ἅς ποκ’ ἔτερπεν,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "47", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἃς λαλέειν ἐδίδασκε, καθεζόμεναι ποτὶ πρέμνοις"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "48", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀντίον ἀλλάλαισιν ἐκώκυον· αἳ δ’ ὑπεφώνευν"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "49", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὄρνιθες λυπεῖσθ’ αἱ πενθάδες· ἀλλὰ καὶ ἡμεῖς."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "50", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "51", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τίς ποτε σᾷ σύριγγι μελίξεται ὦ τριπόθητε;"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "52", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τίς δ’ ἐπὶ σοῖς καλάμοις θήσει στόμα; τίς θρασὺς οὕτως;"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "53", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἰσέτι γὰρ πνείει τὰ σὰ χείλεα καὶ τὸ σὸν ἆσθμα,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "54", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀχὰ δ’ ἐν δονάκεσσι τεᾶς ἔτι βόσκετ’ ἀοιδᾶς."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "55", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Πανὶ φέρω τὸ μέλισμα; τάχ’ ἂν καὶ κεῖνος ἐρεῖσαι"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "56", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸ στόμα δειμαίνοι, μὴ δεύτερα σεῖο φέρηται."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "57", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "58", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κλαίει καὶ Γαλάτεια τὸ σὸν μέλος, ἅν ποκ’ ἔτερπες"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "59", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἑζομέναν μετὰ σεῖο παρ’ ἀϊόνεσσι θαλάσσας."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "60", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐ γὰρ ἴσον Κύκλωπι μελίσδεο· τὸν μὲν ἔφευγεν"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "61", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁ καλὰ Γαλάτεια, σὲ δ’ ἅδιον ἔβλεπεν ἅλμας."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "62", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ νῦν λασαμένα τῶ κύματος ἐν ψαμάθοισιν"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "63", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἕζετ’ ἐρημαίαισι, βόας δ’ ἔτι σεῖο νομεύει."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "64", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "65", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πάντα τοι ὦ βούτα συγκάτθανε δῶρα τὰ Μοισᾶν,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "66", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παρθενικᾶν ἐρόεντα φιλήματα, χείλεα παίδων,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "67", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ στυμνοὶ περὶ σῶμα τεὸν κλαίουσιν Ἔρωτες."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "68", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χἀ Κύπρις ποθέει σε πολὺ πλέον ἢ τὸ φίλημα,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "69", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸ πρώαν τὸν Ἄδωνιν ἀποθνᾴσκοντα φίλησεν."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "70", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῦτό τοι ὦ ποταμῶν λιγυρώτατε δεύτερον ἄλγος,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "71", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῦτο, Μέλη, νέον ἄλγος. ἀπώλετο πρᾶν τοι Ὅμηρος,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "72", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῆνο τὸ Καλλιόπας γλυκερὸν στόμα, καί σε λέγοντι"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "73", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μύρασθαι καλὸν υἷα πολυκλαύτοισι ῥεέθροις,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "74", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πᾶσαν δ’ ἔπλησας φωνᾶς ἅλα· νῦν πάλιν ἄλλον"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "75", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "υἱέα δακρύεις, καινῷ δ’ ἐπὶ πένθεϊ τάκῃ."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "76", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀμφότεροι παγαῖς πεφιλημένοι, ὃς μὲν ἔπινε"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "77", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Παγασίδος κράνας, ὃ δ’ ἔχεν πόμα τᾶς Ἀρεθοίσας."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "78", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χὢ μὲν Τυνδαρέοιο καλὰν ἄεισε θύγατρα"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "79", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ Θέτιδος μέγαν υἷα καὶ Ἀτρείδαν Μενέλαον·"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "80", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῆνος δ’ οὐ πολέμους, οὐ δάκρυα, Πᾶνα δ’ ἔμελπε,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "81", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ βούτας ἐλίγαινε καὶ ἀείδων ἐνόμευε,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "82", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ σύριγγας ἔτευχε καὶ ἁδέα πόρτιν ἄμελγε,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "83", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ παίδων ἐδίδασκε φιλήματα, καὶ τὸν Ἔρωτα"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "84", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔτρεφεν ἐν κόλποισι καὶ ἤρεθε τὰν Ἀφροδίταν."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "85", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "86", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πᾶσα Βίων θρηνεῖ σε κλυτὰ πόλις, ἄστεα πάντα."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "87", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἄσκρα μὲν γοάει σε πολὺ πλέον Ἡσιόδοιο·"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "88", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Πίνδαρον οὐ ποθέοντι τόσον Βοιωτίδες ὗλαι·"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "89", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐ τόσον Ἀλκαίῳ περιμύρατο Λέσβος ἐραννά·"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "90", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδὲ τόσον ὃν ἀοιδὸν ὀδύρατο Τήϊον ἄστυ·"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "91", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σὲ πλέον Ἀρχιλόχοιο ποθεῖ Πάρος· ἀντὶ δὲ Σαπφῶς"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "92", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἰσέτι σεῦ τὸ μέλισμα κινύρεται ἁ Μιτυλάνα."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "93", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἶ δὲ Συρακοσίοισι Θεόκριτος· αὐτὰρ ἐγώ τοι"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "94", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Αὐσονικᾶς ὀδύνας μέλπω μέλος, οὐ ξένος ᾠδᾶς"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "95", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "βουκολικᾶς, ἀλλ’ ἅντε διδάξαο σεῖο μαθητὰς"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "96", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κλαρονόμος Μοίσας τᾶς Δωρίδος, ᾇ με γεραίρων"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "97", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄλλοις μὲν τεὸν ὄλβον, ἐμοὶ δ’ ἀπέλειπες ἀοιδάν."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "98", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "99", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰαῖ ταὶ μαλάχαι μέν, ἐπὰν κατὰ κᾶπον ὄλωνται,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "100", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἠδὲ τὰ χλωρὰ σέλινα τό τ’ εὐθαλὲς οὖλον ἄνηθον,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "101", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὕστερον αὖ ζώοντι καὶ εἰς ἔτος ἄλλο φύοντι·"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "102", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄμμες δ’ οἱ μεγάλοι καὶ καρτεροί, οἱ σοφοὶ ἄνδρες,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "103", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὁππότε πρᾶτα θάνωμες, ἀνάκοοι ἐν χθονὶ κοίλᾳ"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "104", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εὕδομες εὖ μάλα μακρὸν ἀτέρμονα νήγρετον ὕπνον."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "105", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ σὺ μὲν ὦν σιγᾷ πεπυκασμένος ἔσσεαι ἐν γᾷ,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "106", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ταῖς Νύμφαισι δ’ ἔδοξεν ἀεὶ τὸν βάτραχον ᾅδειν."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "107", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ταῖς δ’ ἐγὼ οὐ φθονέοιμι· τὸ γὰρ μέλος οὐ καλὸν ᾅδει."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "108", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "109", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φάρμακον ἦλθε, Βίων, ποτὶ σὸν στόμα, φάρμακον ἦδες—"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "110", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοιούτοις χείλεσσι ποτέδραμε κοὐκ ἐγλυκάνθη;"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "111", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τίς δὲ βροτὸς τοσσοῦτον ἀνάμερος ὡς κεράσαι τοι"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "112", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ δοῦναι καλέοντι τὸ φάρμακον;—ἔκψυγεν ᾠδά."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "113", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄρχετε Σικελικαὶ τῶ πένθεος ἄρχετε Μοῖσαι."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "114", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλὰ Δίκα κίχε πάντας. ἐγὼ δ’ ἐπὶ πένθεϊ τῷδε"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "115", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δακρυχέων τεὸν οἶτον ὀδύρομαι. εἰ δυνάμαν δέ,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "116", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς Ὀρφεὺς καταβὰς ποτὶ Τάρταρον, ὥς ποκ’ Ὀδυσσεύς,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "117", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς πάρος Ἀλκείδας, κἠγὼ τάχ’ ἂν ἐς δόμον ἦνθον"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "118", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Πλουτέος, ὥς κεν ἴδοιμι, καὶ εἰ Πλουτῆι μελίσδεις,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "119", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς ἂν ἀκουσαίμαν, τί μελίσδεαι. ἀλλ’ ἄγε Κώρᾳ"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "120", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Σικελικόν τι λίγαινε και ἁδύ τι βουκολιάζευ."}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "121", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ κείνα Σικελά, καὶ ἐν Αἰτναίαισιν ἔπαιζεν"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "122", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ᾀόσι, καὶ μέλος οἶδε τὸ Δώριον· οὐκ ἀγέραστος"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "123", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐσσεῖθ’ ἁ μολπά. χὠς Ὀρφέϊ πρόσθεν ἔδωκεν"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "124", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁδέα φορμίζοντι παλίσσυτον Εὐρυδίκειαν,"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "125", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ σὲ Βίων πέμψει τοῖς ὤρεσιν. εἰ δέ τι κἠγὼν"}
{"urn": "moschus.epitaphius-bionis-sp", "edition": "perseus-grc2", "locus": "126", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "συρίσδων δυνάμαν, παρὰ Πλουτέϊ κ’ αὐτὸς ἄειδον."}
