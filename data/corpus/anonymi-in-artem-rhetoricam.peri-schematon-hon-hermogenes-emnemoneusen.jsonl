{"urn": "anonymi-in-artem-rhetoricam.peri-schematon-hon-hermogenes-emnemoneusen", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "704.17", "text": "Σχοι-"}
