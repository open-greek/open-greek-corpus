{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.3", "text": "III. Τρωΐλου σοφιστοῦ προλεγόμενα τῆς ῥητορικῆς. 42."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.4", "text": "IV. Ἰωάννου τοῦ Σικελιώτου ἐξήγησις εἰς τὰς ἰδέ- 56."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.5", "text": "ας τοῦ Ἑρμογένοῦς."}
