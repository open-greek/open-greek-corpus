{"urn": "lycophron-tragedy.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0850.18", "source": "ocr", "license": "PD", "text": "v. 3 τοῖς φιληκόσι] πᾶσιν ἐν μέσῳ Ath."}
{"urn": "lycophron-tragedy.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0850.19", "source": "ocr", "license": "PD", "text": "ὁ τὴν ἕω καλῶν"}
