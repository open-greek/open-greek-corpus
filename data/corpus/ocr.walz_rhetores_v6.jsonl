{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0008.21", "text": "XXΙΙΙ."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0008.22", "text": "XXVΙΙΙ."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0008.23", "text": "XXΙΧ."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0008.24", "text": "XXXΙΙΙ."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0009.1", "text": "Τοῦ δ᾽ ἐν γραφῇ δὲ θώκον ἀπειπασμένου"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0009.2", "text": "Ἰωάννης τις, ὁ Γλυκὴς δὲ τοὔπικλην"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0009.3", "text": "Συγκλητικός τε καὶ λογοθέτης Δρόμου"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0009.4", "text": "Εἰς ὧν ἀρίστων καὶ σοφῶν λόγων ἰδρις"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0009.5", "text": "Χειρίζεται δή τὴν λεῶ προστασίαν."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0010.1", "text": "Ἰωάννου Σικελιώτου τοῦ λεγομένου Δοξα πατρὶ"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0010.2", "text": "τοῦ Δοξοπατρῆ] εἰς τὸ περὶ εὐρέσεως Ἑρμογένοῦς βιβλίον."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0010.3", "text": "Ἰωάννου τοῦ Δοξοπατρῆ εἰς τὰ περὶ εὐρέσεως Ἑρμογένοῦς βιβλίον ἐξήγησις."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0010.4", "text": "τοῦ Δοξοπατρῆ Ἰωάννου ὁμιλία εἰς τὰ τοῦ Ἀρθονίου προημνάσματα,"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0010.5", "text": "Ἐξηγήσεις εἰς τὰς ἰδέας τοῦ Ἑρμογένοῦς ἀπὸ φωνῆς Ἰωάννου φιλοσόφου τοῦ Σικελιώτου,"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0010.6", "text": "Συναγωγή ἀναγαιωτάτων ἐξηγήσεων εἰς τὴν ῥητορικὴν τῶν ἀποδοθεισῶν ὑπὸ τε Χριστιανῶν ἐξηγητῶν, καὶ Ἑλλήνων, ὧν εἰσι Χριστιανοὶ μὲν Ἰωάννης Φιλόσοφος μέγας, καὶ ὀρθοδοξότατος ὁ Σικελιώτης, καὶ ἕτερος Ἰωάννης διδάσκαλος ὁ Γεωμέτης, Γρηγόριος μητροπολίτης Κορίνθου, ἕτερος μητροπολίτης Σάρδεων, ὁ Δοξοπατρῆς, κύρις"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0010.7", "text": "Ἰωάννης, Γεώργιος ὁ Διαρετὴς λεγόμενος· Ἕλληνες Σιμπλίκιος, Λογγίνος, Σνριανός, Ἰάμβλιχος."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0011.1", "text": "Προλεγόμενα εἰς τὴν ῥητορικὴν τοῦ Δοξοπατρὶ"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0011.2", "text": "περὶ στάσεων,"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0012.1", "text": "7 Ὁ τοῦ ἵππου λόγος."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0012.2", "text": "8 Ὁ κατὰ Σαρακηνῶν λόγος."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0012.3", "text": "9 Ἀνασκευὴ τοῦ τοῦ Προμηθέως μύθου."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0012.4", "text": "10 Βασιλεῖος δεύτερος, οὗ ἡ ἀρχὴ· „οἱ προσφωνητικοὶ τῶν λόγων, ὦ βασιλεῦ, παραιτοῦνται τὰ μίση τῶν ὑποθέσεων.“"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0012.5", "text": "11 Πολιτικὸς λόγος, οὗ ἡ ἀρχή, „αἰσχρόν, ὦ παρόντες, ὑπὲρ δόξης ἑοῦσης ἀγωνίζεσθαι τὸν φιλόσοφον· οὐ μὴν ἀλλ’ εἴ τις ἕτερος βίων ἐπειτα μὴ τῶν κρειττόνων ἀντιποιεῖται, ἀλλὰ καὶ τὴν χειρῶν δόξαν ἔχει πρὸς τοὺς βελτίστους, φιλάνθρωπον διελέγχειν"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0012.6", "text": "liter mecum communicavit C. E. Chr. Schneider, V. Cl. ad finem commentarii, quem Maximo Planudae vindicavi, haec scripta sunt: Ἐτελειώθη τὸ παρὸν σύγγραμμα, τὸ τοῦ Ἑρμογένους ἐρμηνίως, ὡς φασιν Δοξοπάτρου, διὰ χειρὸς ἐμοῦ Ἰωάννου Φραγκίσκου Βουρρανίου τοῦ ἐπτακαιδεκάτου γεγονότος ἐνιαυτοῦ, καὶ ἐν Βερόνῃ ὑμῶν πατρίδι γεγραμμένος ἔτι ἀπὸ Θεογονίας αὐσα. Coniectura haec commentariorum Doxopatri enumeratione satis refellitur."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.1", "text": "ὡς φανὴρ κοίσει τῆς ἀλαζονείας μεταποιεῖται.“ [Com-"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.2", "text": "osa. Audi ipsum conquerentem de Id. p. 444. τῶν δὲ ἡμετέρων τινὲς νοήματα θεολογικὰ καὶ ταῦθ’ ὡς ἡδύνατο παρέφρασαν· ἐγὼ δὲ μετριῶς ἔχων πρὸς τὴν τοιαύτην κρίσιν τε"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.3", "text": "καὶ διάκρισιν καὶ τὸν πόνον ἀφορῶν τῆς τοιαύτης πραγματείας καὶ τὸ ἀκερδὲς ὑπολογιζόμενος — οὐ γὰρ τῶν ἔχοντων"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.4", "text": "ἐγώ, ἀλλὰ τῶν μόλις ἀποζῶντων καὶ τοῖς ἀναγκαίοις — ὁκνῶ πρὸς τὴν ἐπιχείρησιν· εἰ γὰρ κἂν ἕνα λόγον τῶν σπουδαιotáτων ἐπεμέρισα κατὰ τοὺς ὑποδειχθέντας τύπους ἡμῖν"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.5", "text": "ὑπὸ τοῦ θαυμαστοῦ Ἑρμογένοῦς μετὰ τῶν προσηκόντων"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.6", "text": "ἑκάστῳ θεωρήματι παραδειγμάτων, ἀλλὰ ποῦ σοφός,"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.7", "text": "ποῦ συζητητὴς τῶν τοιούτων; φησὶν ὁ λόγος ὁ ἱερὸς·"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.8", "text": "ποῦ βασιλεὺς Μάρκος ἢ Ἀντωνῖνος ἢ Ἀδριανός, ἢ πατριάρχης, ἢ ἄλλος τις προεχών, ἔργους, ἀλλ’ οὐ λόγοις"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.9", "text": "ἐπὶ ταῦτα προτρέπων; πάντες γὰρ ὡς εἴπαι δημοῦροι"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.10", "text": "καὶ τοὺς ἀρχομένους ἐπὶ τὸ ἴσον ὑπάγοντες καὶ τὴν αὐτὴν ἀλογίαν, ὡσπερ δεδιότες καὶ αἰσχυνόμενοι, μὴ κρεῖττόνων ἀρχωσιν. Sed quo gravius his querelis commoti"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.11", "text": "rat Leo Allatius l. l. p. 327. Χρονικὸν σύντομον ἐκ διαφόρων Χρονογράφων καὶ ἐξηγητῶν συλλεγέν καὶ συντεθὲν"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0013.12", "text": "παρὰ Ἰωάννου μοναχοῦ τοῦ Σικελιώτου, τοῦ καὶ χρηματίσαντος ὕστερον Πατριάρχου Κωνσταντίνου πόλεως νέας Ῥώμης. Ad hanc vitae eius partem opera historica et"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0014.1", "text": "τοῦ αὐτοῦ Ἰωάννου τοῦ Σικελιώτου περὶ τοῦ Ἀδὰμ καὶ τῆς Εὔας καὶ τῶν ἐξ αὐτῶν καταγομένων."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0014.2", "text": "Ἀδὰμ τοίνυν κατὰ τὸν σοφώτατον."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0015.1", "text": "τοῦτον θανόντος ἐγκαθίσταται Ἰωάννης"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0015.2", "text": "ὁ Καματηρὸς εὐεπῆς Ἰωάννης."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0015.3", "text": "Ἰδρὶς σοφίας παντοδαπῆς καὶ λόγων,"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0015.4", "text": "ἐπιβόλος τε δογμάτων τῶν ἐνθέων,"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0015.5", "text": "ἐκκλησίας ὡν Λευίτης χαρτοφύλαξ·"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0015.6", "text": "ἐφ’ οὗ παρεστήσαντο Λατίνοι πόλιν·"}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0015.7", "text": "ὃς ἐξίλαθὲς δυστυχῶς πρὸς Λατίνων"}
