{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.1", "text": "VIII ΠΟΛΥΒΙΟΥ ΣΑΡΔΙΑΝΟΥ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.2", "text": "ΠΕΡΙ ΣΧΗΜΑΤΙΣΜΟΥ.*"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.3", "text": "Μετασχηματισμός ἐστι λέξεως συνήθους κίνησις μέτρου", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.4", "text": "χάριν ἢ κατασκευῆς· ὡς ἐν τῷ κραδίῃ· ἐμφαίνει", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.5", "text": "γὰρ τὴν τοῦ σπλάγχνου ἰδιότητα, ὅτι κραδαίνεται διηνεκῶς.", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.6", "text": "Συστολὴ ἐστιν ἔνδεια χρόνου· γίνεται δὲ ἢτοι διὰ", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.7", "text": "χρόνου παρὰ φύσιν συστελλομένου."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.8", "text": "Οὐκ ἔάσουσιν ἐμοὶ δόμεναι βιὸν ἢδὲ Ἰ φαρέτραν."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.9", "text": "Μετασχηματίζουσι δὲ ἢτοι γένος, οἷον:"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.10", "text": "μηνηθμὸν μὲν ἀποθῦϊαι,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.11", "text": "ἀντὶ τοῦ μήνιν· καὶ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.12", "text": "Μήτοι τι θεῶν μήνιμα γένωμαι·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.13", "text": "Δειλὸς ὁψὲ δύων·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.14", "text": "καὶ,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.15", "text": "Μίνον δ’ ἐπὶ ἑσπερον ἐλθεῖν."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.16", "text": "3 Ir. μὴ τι μήνιμα θεῶν, correxi ex Il. χ. 358. 4 Il. φ. 252."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "611.17", "text": "5 Ir. μένων. — Od. δ. 786."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.1", "text": "ΠΟΛΥΒΙΟΥ ΣΑΡΔΙΑΝΟΥ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.2", "text": "ἀντὶ ἐσπέραν· ἢ ἀριθμόν·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.3", "text": "Μειδιῶν βλοσυροῖσι προσώπασιν· 6"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.4", "text": "ἢ πτώσιν· „Πατροκλῆς δειλοῖο 7 καὶ Σαρπηδόντος ἐταίρον“· 8 ἀντὶ τοῦ Σαρπηδόνος· ἢ διαλύουσι μίαν λέξιν"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.5", "text": "εἰς δύο· πόλιν ἄκρην ἀντὶ τοῦ ἀκρόπολιν· καὶ, „Σάμου 9"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.6", "text": "ὀλησέσης Θρητῖχος,“ ἀντὶ Σαμοθράκης· ἢ δύο εἰς μίαν"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.7", "text": "λέξιν σχηματίζουσι· τὸν γοῦν καθ’ ἕνα ἄνδρα ἄνδρακὰς 10 ἔφη ὁ ποιητής, καὶ τὸ κατὰ μόνους μουνὰς ὀρχήσασθαι· 11 ἢ τὴν σύνθεσιν τῆς λέξεως ἐναλλάττουσιν"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.8", "text": "ὡς παρὰ Σοφοκλεῖ· 12"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.9", "text": "Οἱ γὰρ γύνανδροι καὶ λέγειν ἠσκηότες,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.10", "text": "ἀντὶ τοῦ ἀνδρόγυνοι· γίνεται δὲ μετασχηματισμὸς καὶ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.11", "text": "ὅτ’ ἂν τις τὸ κύριον κατὰ μείωσιν τινα προενέγκῃται."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.12", "text": "“Ὁμηρος·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.13", "text": "“Ἵππους δ’ Αἰτομέδων ἤδ’ Ἄλκιμος. 13"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.14", "text": "ἀντὶ τοῦ Ἄλκιμέδων."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.15", "text": "ΠΕΡΙ ΤΩΝ ΤΗΣ ΚΑΤΑΣΚΕΤΗΣ ΕΙΔΩΝ."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.16", "text": "Ὁμοίως δὲ ἐστὶ λόγος, καθ’ ὃν ὁμοιοῦμεν ἕτερον ἑτέρω. Εἴδη δὲ αὐτῆς τρία· παραβολή, παράδειγμα, εἰκών."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.17", "text": "Παραβολὴ ἐστὶ πρᾶγμα πρᾶγματι παραβαλλόμενον κατὰ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.18", "text": "τι οἰκεῖον αἰξήσεως ἢ ἐμφάσεως ἢ σαφηνείας ἕνεκα· αἰξήσεως μὲν·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.19", "text": "Ὡς δ’ ὅτ’ ἂν ἀστράπτῃ πόσις “Ἥρης ἡὑκόμοιο,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.20", "text": "Ὡς πυκινὸν 14 ἐν στήθεσσιν ἀνεστενάχζεν Ἄγαμέμνων·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.21", "text": "ἐμφάσεως δέ·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.22", "text": "Ἐν δ’ ἔπεσ’, 15 ὡς ὅτε κύμα θοῆ ἐνὶ νηὶ πέσῃσι"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "612.23", "text": "Λάβρον."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.1", "text": "ΠΕΡΙ ΣΧΗΜΑΤΙΣΜΟΥ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.2", "text": "σαφηνειας δ᾽ ἑνεκα·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.3", "text": "— — — ἐπὶ δ᾽ ὄρνυτο δῖος Ὀδυσεὺς 16"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.4", "text": "Ἄγχι μάλ᾽, ὡς ὅτε τις τε γυναικὸς ἐὐζώνοιο"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.5", "text": "Στιβθεὸς ἐστι κανόν, ὅντ᾽ 17 ἐὐ μᾶλα χειρὶ τανύσση"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.6", "text": "Πηνιον ἐξέλκουσα παρὰν μίτον.18"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.7", "text": "Εἰσὶ δὲ τῶν παραβολῶν αἱ μὲν ἀνταποδοτικαί, αἱ δὲ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.8", "text": "ἀπόλυτοι· ἀνταποδοτικαὶ μὲν αἱ τοιαῦται·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.9", "text": "Ὡς δὲ λέων 19 ἐν βοαῖ θορῶν ἐξ αὐχένα ἄξει"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.10", "text": "Πόρθιος ἢ βοὸς, καὶ ἐξῆς·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.11", "text": "Ὡς τοὺς ἀμφοτέρους ἐξ ἵππων Τυδέος υἱὸς"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.12", "text": "Ἦψε κακῶς ἀείκοντας."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.13", "text": "καὶ ἐστιν ἀνταποδιδόμενος τῇ παραβολῇ."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.14", "text": "Ἀπόλυτοι δὲ εἰσιν αἱ δίχα ἀνταποδόσεως λεγόμεναι,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.15", "text": "οἷον·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.16", "text": "Ὡστε γὰρ ἢ παῖδες νεαροὶ χῆραι τε γυναῖκες"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.17", "text": "Ἀλλήλοισιν οὐδύονται οἴκονδε 20 νέεσθαι."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.18", "text": "Παράδειγμα δὲ ἐστι λόγος διὰ τῆς ὁμοίων παραθέσεως", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.19", "text": "προτροπὴν ἢ ἀποτροπὴν ἢ ἀπόδειξιν τινων ἔχων· 21", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.20", "text": "προτροπὴν μὲν"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.21", "text": "Ἡ οὐκ ἄτεις οἷον κλέος ἔλαβε δῖος 22 Ὀρέστης."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.22", "text": "καὶ τὰ ἐξῆς· ἀποτροπὴν δὲ,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.23", "text": "Οὐδὲ γὰρ οὐδὲ Ἀγύαντος υἱὸς 23 κρατερὸς Λυκόεργος·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.24", "text": "ἀπόδειξιν δὲ τὸ παράδειγμα οὕτως ἔχει·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.25", "text": "Σχετλιοὶ ἐστὲ θεοὶ ζηλήμονες 24 ἔξοχον ἄλλων"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.26", "text": "Οἱ τε θεαῖς ἀγάασθε παρ᾽ ἀνδράσιν εὐνάζεσθαι."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.27", "text": "εἶτα·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "613.28", "text": "Ὡς μὲν ὅτ᾽ Ὠρίων᾽ 25 ἔλετο ῥοδοδάκτυλος Ἥως·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.1", "text": "ΠΟΛΥΒΙΟΥ ΣΑΡΔΙΑΝΟΥ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.2", "text": "Ὦς δ’ ὁπότ’ Ἰασίωνι ἐϋπλόκαμος Δημήτηρ,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.3", "text": "Ὦς αὐ νῦν μοι ἀγάασθε θεοὶ βροτὸν ἄνδρα παρεῖναι."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.4", "text": "παράκειται τῷ παραδείγματι καὶ ἡ καλουμένη ἐπαγωγή."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.5", "text": "Ἐπαγωγὴ δέ ἐστιν, ὅτ’ ἂν τι τῶν ὁμοίων προθέντες"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.6", "text": "ἐπάγωμεν, εἰς ὃ συμπεύθομεν, οἷον·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.7", "text": "Μὴ τι τοὶ δρυτόμος μέγ’ ἀμείνων, ἢ βίφει·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.8", "text": "Μήτι δ’ αὔτε κυβερνήτης ἐνὶ οἴνοπι πόντῳ,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.9", "text": "Νῆμα Θοήν ἰθύνει ἐρεχθομένην ἀνέμοισιν·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.10", "text": "εἰτ’ ἐπάγει·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.11", "text": "Μήτι δ’ ἡνίοχος περιγίνεται ἡνίοχοιο."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.12", "text": "Εἰκὼν ἐστι λόγος εἴδους εἴδει παρατεθεὶς ὁλοσχερῶς", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.13", "text": "ἢ ἀπὸ μέρους· ὀλεσχερῶς μὲν", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.14", "text": "Ἄρτεμιδι ἰκέλη ἢ χρυσῇ Ἀφροδίτη·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.15", "text": "ἀπὸ μέρους δέ,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.16", "text": "Ὄμματα καὶ κεφαλὴν ἴκελος Διὶ τετπικεραύνῳ."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.17", "text": "Ἀρεὶ δὲ ζώνην, στέρερον δὲ Ποσειδάωνι·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.18", "text": "Παράκειται δὲ τῇ εἰκόνι ἐννέα· εἰκονισμοί, εἰконо-"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.19", "text": "γραφία, ὑποτύπωσις, εἰδωλοποιία, εἰκασία, εἰδικὴ ὁμοίωσις,", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.20", "text": "χαρακτήρισμα, τοποθεσία καὶ τοπογραφία. Εἰκονισμός", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.21", "text": "ἐστι σώματος ἰδίως ἀπόδοσις ἐξ ἱστορίας λαμβανομενος·", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.22", "text": "οἷον·", "corrections": ["dehyphenation"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.23", "text": "Γυρὸς ἐν ὤμοισιν, μελανόχροος, οὐλοκάρηνος."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.24", "text": "καὶ τὸ ἐπὶ Θερσίτου·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "614.25", "text": "Φολκὸς ἦν, χωλὸς δ’ ἕτερον πόδα."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.1", "text": "ΠΕΡΙ ΣΧΗΜΑΤΙΣΜΟΥ"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.2", "text": "τὸ δ᾽ αὐτὸ καὶ εἰκονογραφία ἂν εἴη, ὅτ᾽ ἂν κατὰ τὴν ἀπόδοσιν τῆς μορφῆς ὁμοιώσεως ἐφάπτηται."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.3", "text": "ὑποτύπωσις ἐστὶ σώματος ἰδίως ἀπόδοσις πεπλασμένου,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.4", "text": "Καὶ γὰρ τε λυταὶ εἰσι Διὸς κόραι μεγάλοι,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.5", "text": "Χωλαὶ τε ὕψαι τε παραβλώπες τ᾽ ὀφθαλμῶ."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.6", "text": "Παρακεῖται δ᾽ αὐτῇ εἰδωλοποιία, ὅτ᾽ ἂν δαίμονας τινὰς ἀπὸ πραγμάτων ἀναπλάττωμεν, ὡς τὰς λυτὰς Ὅμηρος."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.7", "text": "Εἰκασία ἐστὶ φράσεως ὑπόληψις ἰδιώσεως μορφὴν ἐμφαίνουσα."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.8", "text": "Εἰ μὲν τίς θεὸς ἔστι, τοῦ οὐρανοῦν εὐρὺν ἔχουσι,", "corrections": ["confusion"]}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.9", "text": "Ἀρτεμίδι σε ἐγὼγε Διὸς κόρη μεγάλοι"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.10", "text": "Εἴδος τε μέγεθός τε φυὴν τ᾽ ἄχιστα εὖκοῦ."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.11", "text": "Ἡ δὲ εἰδικὴ ὁμοίωσις ἐστὶ παράθεσις ὁμοίων χαρακτήρων· οἷον"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.12", "text": "Κείνου γὰρ τοιοῦδε πόδες, τοιαῦδε τε χεῖρες,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.13", "text": "Ὀφθαλμῶν τε βολαί, κεφαλὴ τ᾽ ἐφύπερθ᾽ τε χαῖται."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.14", "text": "Χαρακτηρισμὸς ἐστὶν ὑποτύπωσις ἰδιώματος ψυχῆς, οἷον·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.15", "text": "Εὔ δὲ σὺ οἶδα, γεραῖ διotreφεῖς, οἷον ἐκεῖνος"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.16", "text": "Δεινὸς ἀνήρ· τάχα κεν καὶ ἀναίτιον αἰτίωστο."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.17", "text": "Τοποθεσία ἐστὶ τόπων ἰδίων ἀπόδοσις ὑφαιστώτων, οἷά ἐστι τὰ ἐπὶ τῆς Ἰθάκης,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.18", "text": "Φόρκυνος μὲν ὁδ᾽ ἐστὶ λιμὴν ἀλίου γείροντος"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.19", "text": "Ἐν δήμῳ Ἰθάκης· δύο δὲ προβλήται ἐν αὐτῇ."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "615.20", "text": "καὶ ξῆς."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.1", "text": "ΠΟΛΥΒ. ΣΑΡΔΙΑΝ. ΠΕΡΙ ΣΧΗΜ."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.2", "text": "Τοπογραφία ἐστὶ τόπου ἰδίως ἀπόδοσις πεπλασμένον, ὡς ἔχει ἡ τε Καλυψοῦς νῆσος,"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.3", "text": "\"Τὴν δὲ σπῖος ἀμφὶ πεφύκει 43 τηλεθόωσα·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.4", "text": "καὶ τὰ ἐπὶ τῆς Λεχέιας·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.5", "text": "Νῆσος ἔπειτα Λέχεια παρακεκλιμένη 44 τετάνυσται."}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.6", "text": "Εἶδος δ' ἂν εἴη τῆς ὁμοιώσεως καὶ ἡ καλουμένη διαφορά, ἥτις πᾶσι τοῖς ἄλλοις τῆς ὁμοιώσεως εἴδεσιν ἀντέστραπται· οἷον·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.7", "text": "Οὔτε θαλάσσης κῦμα τόσον βοάα 45 ποτὶ χέρσον·"}
{"urn": "polybius-sardianus.peri-schematismou", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "616.8", "text": "καὶ τὰ ἑξῆς."}
