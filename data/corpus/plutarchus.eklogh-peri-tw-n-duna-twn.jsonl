{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "19", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Λύκου πτερὸν ζητεῖς."}
