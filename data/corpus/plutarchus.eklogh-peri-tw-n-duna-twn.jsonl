{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "1", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Κατὰ πετρῶν σπείρεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "2", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Πλίνθον πλύνεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "3", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Δικτύῳ ἄνεμον θηρᾷς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "4", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Εἰς πίθον ἀντλεῖς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "5", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Εἰς ὕδωρ γράφεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "6", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Εἰς οὐρανὸν τοξεύεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "7", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Αἰθίοπα σμήχεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "8", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Κοσκίνῳ ὕδωρ ἀντλεῖς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "9", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Νεκρὸν μαστίζεις."}
