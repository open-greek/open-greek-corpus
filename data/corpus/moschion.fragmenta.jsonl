{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.2", "source": "ocr", "license": "PD", "text": "ΘΕΜΙΣΤΟΚΛΗΣ"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.3", "source": "ocr", "license": "PD", "text": "καὶ γὰρ ἐν νάπαις βραχεῖ"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.4", "source": "ocr", "license": "PD", "text": "πολὺς σιδήρῳ κείρεται πεύκης κλάδος,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.5", "source": "ocr", "license": "PD", "text": "καὶ βαλὸς ὕχλος μυρίας λόγχης κρατεῖ."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.6", "source": "ocr", "license": "PD", "text": "Stob. Flor. 51, 21: Μοσχίωνος ἐκ Θεμιστοκλέους. ‘καὶ γὰρ — κρατεῖ’."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.7", "source": "ocr", "license": "PD", "text": "ΘΗΛΕΦΟΣ"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.8", "source": "ocr", "license": "PD", "text": "ὦ καὶ θεῶν κρατοῦσα καὶ θνητῶν μόνη"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.9", "source": "ocr", "license": "PD", "text": "μοῖρ’, ὦ λιταῖς ἄτεγκτε δυστήνων βροτῶν,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.10", "source": "ocr", "license": "PD", "text": "πάντολμ’ ἀνάγκη, στυγνὸν ἢ κατ’ αὐχένων"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.11", "source": "ocr", "license": "PD", "text": "ἡμῶν ἐρείδεις τῆσδε λατρείας ξυρόν."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0844.12", "source": "ocr", "license": "PD", "text": "ΦΕΡΑΙΟΙ"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.1", "source": "ocr", "license": "PD", "text": "κενὸν θανόντος ἀνδρὸς αἰκίζειν σκιάν·"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.2", "source": "ocr", "license": "PD", "text": "ζῶντας κολάζειν, οὐ θανόντας εὐσεβές."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.3", "source": "ocr", "license": "PD", "text": "ὡμῶς τὸ γ’ ὀρθὸν καὶ δίκαιον οὐποτε"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.4", "source": "ocr", "license": "PD", "text": "σιγῇ παρήσω· τὴν γὰρ ἐντεθραμμένην"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.5", "source": "ocr", "license": "PD", "text": "ἀστοῖς ’Αθάνας τῇ τε Θησέως πόλει"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.6", "source": "ocr", "license": "PD", "text": "καλὸν φυλάξαι γνησίως παρρησίαν."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.7", "source": "ocr", "license": "PD", "text": "Stob. Flor. 13, 14: Μοσχίωνος (sic SMA, lemma om. L). ‘ὡμῶς — παρρησίαν’. v. 3 ἄθανάς M."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.8", "source": "ocr", "license": "PD", "text": "μόνον σὺ θυμοῦ χωρὶς ἔνδεξαι λόγους"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.9", "source": "ocr", "license": "PD", "text": "οὓς σοι κομίζω· τὸν κλύοντα γὰρ λαβὼν"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.10", "source": "ocr", "license": "PD", "text": "ὁ μῦθος εὖνουν οὐ μάτην λεχθήσεται."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.11", "source": "ocr", "license": "PD", "text": "Stob. Flor. 46, 14: Μοσχίωνος (sie S, eclogam om. MA). ‘μόνον — λεχθήσεται.’ v. 2 οὓς σὺ S, οὓς σοι Trinc."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.12", "source": "ocr", "license": "PD", "text": "πρῶτον δ’ ἄνειμι καὶ διαπτύξω λόγῳ"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.13", "source": "ocr", "license": "PD", "text": "ἀρχὴν βροτείου καὶ κατάστασιν βίου."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.14", "source": "ocr", "license": "PD", "text": "ἦν γὰρ ποτ’ αἰὼν κείνος, ἦν ποθ’ ἡνίκα"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.15", "source": "ocr", "license": "PD", "text": "θηρίν διαίτας εἶχον ἐμφερεῖς βροτοί,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.16", "source": "ocr", "license": "PD", "text": "ὀρειγενῆ σπήλαια καὶ δυσηλίους"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.17", "source": "ocr", "license": "PD", "text": "φάραγγας ἐνναίουτες· οὐδέπω γὰρ ἦν"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.18", "source": "ocr", "license": "PD", "text": "οὔτε στερήρης οἶκος οὔτε λαΐνοις"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.19", "source": "ocr", "license": "PD", "text": "εὐρεῖα πύργοις ὠχυρωμένη πόλις."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0845.20", "source": "ocr", "license": "PD", "text": "οὐ μὴν ἀρότροις ἀρχύλοις ἐτέμνετο"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.1", "source": "ocr", "license": "PD", "text": "μέλαινα καρποῦ βῶλος ὀμπνίου τροφός, 10"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.2", "source": "ocr", "license": "PD", "text": "οὐδ᾽ ἐργάτης σίδηρος εὐώτιδος"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.3", "source": "ocr", "license": "PD", "text": "θάλλοντας οἴνης ὀρχάτους ἐτημέλει,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.4", "source": "ocr", "license": "PD", "text": "ἀλλ᾽ ἦν ἀκίμων καφεύουσα θέουσα γῆ."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.5", "source": "ocr", "license": "PD", "text": "βόραι δὲ σαρκοβόρτες ἀλληλοκτόνους"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.6", "source": "ocr", "license": "PD", "text": "παρεῖχον αὐτοῖς δαΐτας· ἦν δ᾽ ὁ μὲν νόμος 15"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.7", "source": "ocr", "license": "PD", "text": "ταπεινός, ἡ βία δὲ σύνθρονος Διί."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.8", "source": "ocr", "license": "PD", "text": "[ὁ δ᾽ ἀσθενὴς ἦν τῶν ἀμεινόνων βορά.]"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.9", "source": "ocr", "license": "PD", "text": "ἐπεὶ δ᾽ ὁ τίκτων πάντα καὶ τρέφων χρόνος"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.10", "source": "ocr", "license": "PD", "text": "τὸν θνητὸν ἠλλοίωσεν ἐπαλιὸν βίον,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.11", "source": "ocr", "license": "PD", "text": "εἴτ᾽ οὖν μέριμναν τὴν Προμηθέως πάρα 20"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.12", "source": "ocr", "license": "PD", "text": "εἴτ᾽ οὖν ἀνάγκην εἴτε τῇ μακρᾷ τριβῇ"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.13", "source": "ocr", "license": "PD", "text": "αὐτὴν παρασχὼν τὴν φύσιν διδάσκαλον,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.14", "source": "ocr", "license": "PD", "text": "τόθ᾽ ὑφρέθη μὲν καρπὸς ἡμέρου τροφῆς"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.15", "source": "ocr", "license": "PD", "text": "Δήμητρος ἀγνῆς, ὑφρέθη δὲ Βακχίου"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.16", "source": "ocr", "license": "PD", "text": "γλυκεῖα πηγή, γαῖα δ᾽ ἡ πρὶν ἄσπορος 25"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.17", "source": "ocr", "license": "PD", "text": "ἤδη ζυγουλκοῖς βουσὶν ἠροτρεύετο,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.18", "source": "ocr", "license": "PD", "text": "ἅστη δ᾽ ἐπυρώσαντο καὶ περισκεπεῖς"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.19", "source": "ocr", "license": "PD", "text": "ἑτενξαν οἴκους καὶ τὸν ἠργιαμένον"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.20", "source": "ocr", "license": "PD", "text": "εἰς ἡμερον δίαιταν ἤγαγον βίον."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.21", "source": "ocr", "license": "PD", "text": "κἀκ τοῦδε τοὺς θανόντας ὥρισεν νόμος 30"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.22", "source": "ocr", "license": "PD", "text": "τύμβοις καλύπτειν κάπμοιρᾶσθαι κόριν"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.23", "source": "ocr", "license": "PD", "text": "νεκροῖς ἀθάπτοις, μὴδ᾽ ἐν ὀφθαλμοῖς ἐὰν"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.24", "source": "ocr", "license": "PD", "text": "τῆς πρόσθε θοίνης μνημόνευμα δυσσεβοῦς."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0846.25", "source": "ocr", "license": "PD", "text": "Stob. Ecl. 1, 8, 38 p. 100, 2: Μοσχίωνος (οσχιώνος F, lemma om. P). ‘πρώτον — δυσσεβές’. v. 3 ἦν ποθ’ ἡνίκα scripsi, ἦν ὀπηνίκα FP. v. 4 θησεὶ FP. v. 5 δυσήλους dubito num integrum sit, olim δυσανλίους proposui, nunc δυσχεμέρους malim. v. 7 λαγγήνοις F, λαγῆνοις P pr. m., λαΐνοις P m. sec. v. 8 ὠχυρομένους F. v. 9 καμπύλους malim, cf. καμπύλ’ ἄροτρα Hymn. Cer. 308 et Solon. fr. 13, 48 et εὐκαμπὲς ἄροτρον Mosch. 2, 81 et Maxim. περὶ καταρχῶν 458. ἐγέμετο F. v. 10 κάρπος (καρπὸν sec. m.) P. ὀμπνίου P. v. 11 εὐγωτίδος FP, εὐώτιδος Grotius. v. 12 ὀρχάτους τεμελλει F’, ὀρχατους . . . μένει P, ὀρχάτους ἐτημέλει Salmadius. v. 13 καφεύουσα θέουσα FP, κοῦ τροφὴν φέρουσα coni. Tyrwhitt, καφά τ’ ἐκφύουσα (vel ἐκφέρουσα) Heeren, καφὰ χηρεύουσα (aptius erat χηρεσέουσα) Meineke, ego κοῦ φυτοῖς βρύουσα praetulerim. κνωδάλων βρύουσα Methner progr. a. 1882 p. 9, κάφνωσ ἀργοῦσα Haupt Opusc. 3 p. 471 sq., καφόνους τ’ ἀργοῦσα Vsener, καὶ φυτῶν ἀργοῦσα F. G."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.1", "source": "ocr", "license": "PD", "text": "κέρδος οὐκέτ’ ὄντας ὀβρίζειν νεκρούς;"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.2", "source": "ocr", "license": "PD", "text": "τί τὴν ἀναυδὸν γαῖαν αἰκίζειν πλέον;"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.3", "source": "ocr", "license": "PD", "text": "ἐπὰν γὰρ ἡ κρῖνουσα καὶ τὰς ἡδονὰς"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.4", "source": "ocr", "license": "PD", "text": "καὶ τάνιαρὰ φροῦδος αἰσθησις φθαρῇ,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.5", "source": "ocr", "license": "PD", "text": "τὸ σῶμα καυφοῦ τάξιν εἴληφεν πέτρου."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.6", "source": "ocr", "license": "PD", "text": "ἥν ἄρα τρανὸς αἴνος ἀνθρώπων ὤδε,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.7", "source": "ocr", "license": "PD", "text": "ὡς τὸν πέλας μὲν νοῦθετεῖν βραχὺς πόνος,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.8", "source": "ocr", "license": "PD", "text": "αὐτὸν δ’ ἐνεγκεῖν ὀβρίν ἠδικημένον"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.9", "source": "ocr", "license": "PD", "text": "πάντων μέγιστον τῶν ἐν ἀνθρώποις βάρος."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0847.10", "source": "ocr", "license": "PD", "text": "Stob. Flor. 114, 9: Μοσχίωνος. ‘ἥν — βάρος’. v. 1 ἄρα libri. v. 2 τοὺς πέλας coni. Burges. βραχὺς χρόνος A. v. 3 αὐτὸν S, αὐτὸν MA."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.1", "source": "ocr", "license": "PD", "text": "σὺν αἴσι δόξῃ πρόσθε καὶ γένει μέγας"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.2", "source": "ocr", "license": "PD", "text": "Ἄργους δυνάστης, λειτὸς ἐκ τυραννικῶν"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.3", "source": "ocr", "license": "PD", "text": "θρόνων, προσίκην θάλλον ἠκαλισμένος"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.4", "source": "ocr", "license": "PD", "text": "ἔστειχεν εἰς γῆν, ὕμνα συμπαθὲς φέρων"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.5", "source": "ocr", "license": "PD", "text": "καὶ πᾶσι δεικνὺς ὡς τὰ λαμπρὰ τῆς τύχης"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.6", "source": "ocr", "license": "PD", "text": "τὴν κτῆσιν οὐ βέβαιον ἀνθρώποις νέμει."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.7", "source": "ocr", "license": "PD", "text": "ὃν πᾶς μὲν ἀστῶν ἠλέξεν εἰσιδών,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.8", "source": "ocr", "license": "PD", "text": "ἅπας δὲ χεῖρα καὶ προσήγορον φάτιν"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.9", "source": "ocr", "license": "PD", "text": "ῶρεξε κανθούς τ' ἐξέτῃξε δακρύοις"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.10", "source": "ocr", "license": "PD", "text": "τύχαις συναλγῶν· τάξιωμα γὰρ νοσοῦν"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.11", "source": "ocr", "license": "PD", "text": "τὸ πρόσθε πολλοῖς οἴκτον ἐμποεῖ βροτῶν."}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.13", "source": "ocr", "license": "PD", "text": "κεῖνος δ' ἀπάντων ἐστὶ μακαριώτατος,"}
{"urn": "moschion.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0848.14", "source": "ocr", "license": "PD", "text": "ὃς διὰ τέλους ζῶν ὁμαλὸν ἥσκησεν βίον."}
