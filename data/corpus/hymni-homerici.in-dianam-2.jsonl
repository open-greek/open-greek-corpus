{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἄρτεμιν ἀείδω χρυσηλάκατον, κελαδεινήν,"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παρθένον αἰδοίην, ἐλαφηβόλον, ἰοχέαιραν,"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτοκασιγνήτην χρυσαόρου Ἀπόλλωνος,"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἣ κατ’ ὄρη σκιόεντα καὶ ἄκριας ἠνεμοέσσας"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄγρῃ τερπομένη παγχρύσεα τόξα τιταίνει"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πέμπουσα στονόεντα βέλη· τρομέει δὲ κάρηνα"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὑψηλῶν ὀρέων, ἰάχει δ’ ἔπι δάσκιος ὕλη"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δεινὸν ὑπὸ κλαγγῆς θηρῶν, φρίσσει δέ τε γαῖα"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πόντος τ’ ἰχθυόεις· ἣ δ’ ἄλκιμον ἦτορ ἔχουσα"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πάντη ἐπιστρέφεται θηρῶν ὀλέκουσα γενέθλην."}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτὰρ ἐπὴν τερφθῇ θηροσκόπος ἰοχέαιρα,"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εὐφρήνῃ δὲ νόον, χαλάσασ’ εὐκαμπέα τόξα"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔρχεται ἐς μέγα δῶμα κασιγνήτοιο φίλοιο,"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Φοίβου Ἀπόλλωνος, Δελφῶν ἐς πίονα δῆμον,"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Μουσῶν καὶ Χαρίτων καλὸν χορὸν ἀρτυνέουσα."}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔνθα κατακρεμάσασα παλίντονα τόξα καὶ ἰοὺς"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἡγεῖται χαρίεντα περὶ χροῒ κόσμον ἔχουσα,"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "18", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐξάρχουσα χορούς· αἳ δ’ ἀμβροσίην ὄπ’ ἰεῖσαι"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "19", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὑμνεῦσιν Λητὼ καλλίσφυρον, ὡς τέκε παῖδας"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "20", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀθανάτων βουλῇ τε καὶ ἔργμασιν ἔξοχ’ ἀρίστους."}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "21", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χαίρετε, τέκνα Διὸς καὶ Λητοῦς ἠυκόμοιο·"}
{"urn": "hymni-homerici.in-dianam-2", "edition": "perseus-grc2", "locus": "22", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτὰρ ἐγὼν ὑμέων τε καὶ ἄλλης μνήσομ’ ἀοιδῆς."}
