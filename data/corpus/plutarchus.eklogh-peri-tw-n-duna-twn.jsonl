{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "23", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Αἰγιαλῷ λαλεῖς."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "24", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Λίθῳ διαλέγου."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "25", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἄνεα πτερῶν ζητεῖς ἵπτασθαι."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "26", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Φαλακρῷ κτένας δανείζεις."}
