{"urn": "hymni-homerici.in-jovem", "edition": "perseus-grc2", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ζῆνα θεῶν τὸν ἄριστον ἀείσομαι ἠδὲ μέγιστον,"}
{"urn": "hymni-homerici.in-jovem", "edition": "perseus-grc2", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εὐρύοπα, κρείοντα, τελεσφόρον, ὅστε Θέμιστι"}
{"urn": "hymni-homerici.in-jovem", "edition": "perseus-grc2", "locus": "3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐγκλιδὸν ἑζομένῃ πυκινοὺς ὀάρους ὀαρίζει."}
{"urn": "hymni-homerici.in-jovem", "edition": "perseus-grc2", "locus": "4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἵληθʼ, εὐρύοπα Κρονίδη, κύδιστε μέγιστε."}
