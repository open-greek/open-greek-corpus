{"urn": "anonymi-in-artem-rhetoricam.peri-schematon-hon-hermogenes-emnemoneusen", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "705.7", "text": "καὶ Τριβαλλούς, τινὰς δὲ καὶ τῶν Ἑλλήνων", "corrections": ["dehyphenation"]}
