{"urn": "lycophron-tragedy.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0849.7", "source": "ocr", "license": "PD", "text": "ΜΕΝΕΔΗΜΟΣ ΣΑΤΤΡΟΙ"}
{"urn": "lycophron-tragedy.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0849.8", "source": "ocr", "license": "PD", "text": "παῖδες κρατίστον πατρὸς ἐξωλέστατοι,"}
{"urn": "lycophron-tragedy.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0849.9", "source": "ocr", "license": "PD", "text": "ἐγὼ μὲν ὑμῖν, ὡς ὁρᾶτε, στερησιῶ·"}
{"urn": "lycophron-tragedy.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0849.10", "source": "ocr", "license": "PD", "text": "δεῖπνον γὰρ οὔτ’ ἐν Καρίᾳ, μὰ τοὺς θεούς,"}
{"urn": "lycophron-tragedy.fragmenta", "edition": "nauck-tgf-ocr", "locus": "nauck_tgf_1889_0849.11", "source": "ocr", "license": "PD", "text": "οὔτ’ ἐν Ῥόδῳ τοιοῦτον οὔτ’ ἐν Λυδίᾳ"}
