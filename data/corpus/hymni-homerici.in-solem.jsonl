{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἥλιον ὑμνεῖν αὖτε Διὸς τέκος ἄρχεο Μοῦσα,"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Καλλιόπη, φαέθοντα, τὸν Εὐρυφάεσσα βοῶπις"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γείνατο Γαίης παιδὶ καὶ Οὐρανοῦ ἀστερόεντος·"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γῆμε γὰρ Εὐρυφάεσσαν ἀγακλειτὴν Ὑπερίων,"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτοκασιγνήτην, ἥ οἱ τέκε κάλλιμα τέκνα,"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἠῶ τε ῥοδόπηχυν ἐυπλόκαμόν τε Σελήνην"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἠέλιόν τʼ ἀκάμαντʼ, ἐπιείκελον ἀθανάτοισιν,"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὃς φαίνει θνητοῖσι καὶ ἀθανάτοισι θεοῖσιν"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἵπποις ἐμβεβαώς· σμερδνὸν δʼ ὅ γε δέρκεται ὄσσοις"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χρυσέης ἐκ κόρυθος· λαμπραὶ δʼ ἀκτῖνες ἀπʼ αὐτοῦ"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰγλῆεν στίλβουσι παρὰ κροτάφων δέ τʼ ἔθειραι"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λαμπραὶ ἀπὸ κρατὸς χαρίεν κατέχουσι πρόσωπον"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τηλαυγές· καλὸν δὲ περὶ χροῒ λάμπεται ἔσθος"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λεπτουργές, πνοιῇ ἀνέμων· ὕπο δʼ ἄρσενες ἵπποι."}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔνθʼ ἄρʼ ὅ γε στήσας χρυσόζυγον ἅρμα καὶ ἵππους,"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "15a", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "[αὐτόθι παύεται ἄκρου ἐπʼ οὐρανοῦ, εἰσόκεν αὖτις]"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θεσπέσιος πέμπῃσι διʼ οὐρανοῦ Ὠκεανόνδε."}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χαῖρε, ἄναξ, πρόφρων δὲ βίον θυμήρεʼ ὄπαζε."}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "18", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐκ σέο δʼ ἀρξάμενος κλῄσω μερόπων γένος ἀνδρῶν"}
{"urn": "hymni-homerici.in-solem", "edition": "perseus-grc2", "locus": "19", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἡμιθέων, ὧν ἔργα θεαὶ θνητοῖσιν ἔδειξαν."}
