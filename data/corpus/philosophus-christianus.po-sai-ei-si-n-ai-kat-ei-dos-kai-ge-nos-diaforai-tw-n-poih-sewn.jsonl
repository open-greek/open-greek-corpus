{"urn": "philosophus-christianus.po-sai-ei-si-n-ai-kat-ei-dos-kai-ge-nos-diaforai-tw-n-poih-sewn", "edition": "qwen36-berthelot_alchimistes_grec", "locus": "berthelot_alchimistes_grec_0454.20", "source": "ocr", "license": "PD", "text": "δ’."}
{"urn": "philosophus-christianus.po-sai-ei-si-n-ai-kat-ei-dos-kai-ge-nos-diaforai-tw-n-poih-sewn", "edition": "qwen36-berthelot_alchimistes_grec", "locus": "berthelot_alchimistes_grec_0454.21", "source": "ocr", "license": "PD", "text": "μιᾶς μοίρας τῶν ὤων εἰσὶν οἰκονομίαι ΛΓ’"}
