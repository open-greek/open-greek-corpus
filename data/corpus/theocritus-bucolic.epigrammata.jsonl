{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "1.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὰ ῥόδα τὰ δροσόεντα καὶ ἁ κατάπυκνος ἐκείνα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "1.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἕρπυλλος κεῖται ταῖς Ἑλικωνιάσι,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "1.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ταὶ δὲ μελάμφυλλοι δάφναι τὶν Πύθιε Παιάν,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "1.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δελφὶς ἐπεὶ πέτρα τοῦτό τοι ἀγλάισε."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "1.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "βωμὸν δʼ αἱμαξεῖ κεραὸς τράγος οὗτος ὁ μαλός,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "1.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τερμίνθου τρώγων ἔσχατον ἀκρεμόνα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "2.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Δάφνις ὁ λευκόχρως, ὁ καλᾷ σύριγγι μελίσδων"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "2.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "βουκολικοὺς ὕμνους, ἄνθετο Πανὶ τάδε,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "2.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοὺς τρητοὺς δόνακας, τὸ λαγωβόλον, ὀξὺν ἄκοντα,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "2.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νεβρίδα, τὰν πήραν, ᾇ ποκʼ ἐμαλοφόρει."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "3.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εὕδεις φυλλοστρῶτι πέδῳ Δάφνι σῶμα κεκμακὸς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "3.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀμπαύων· στάλικες δʼ ἀρτιπαγεῖς ἀνʼ ὄρη."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "3.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀγρεύει δέ τυ Πὰν καὶ ὁ τὸν κροκόεντα Πρίηπος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "3.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κισσὸν ἐφʼ ἱμερτῷ κρατὶ καθαπτόμενος,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "3.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄντρον ἔσω στείχοντες ὁμόρροθοι. ἀλλὰ τὺ φεῦγε,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "3.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φεῦγε μεθεὶς ὕπνου κῶμα καταγρόμενον."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τήναν τὰν λαύραν τάς τε δρύας αἰπόλε κάμψας"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σύκινον εὑρήσεις ἀρτιγλυφὲς ξόανον,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τρισκελὲς αὐτόφλοιον ἀνούατον, ἀλλὰ φάλητι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παιδογόνῳ δυνατὸν Κύπριδος ἔργα τελεῖν."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σακός οἱ ἱερὸς περιδέδρομεν, ἀέναον δὲ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ῥεῖθρον ἀπὸ σπιλάδων πάντοσε τηλεθάει"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δάφναις καὶ μύρτοισι καὶ εὐώδει κυπαρίσσῳ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔνθα πέριξ κέχυται βοτρυόπαις ἕλικι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄμπελος, εἰαρινοὶ δὲ λιγυφθόγγοισιν ἀοιδαῖς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κόσσυφοι ἀχεῦσιν ποικιλότραυλα μέλη."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ξουθαὶ δʼ ἀδονίδες μινυρίσμασιν ἀνταχεῦσι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μέλπουσαι στόμασιν τὰν μελίγαρυν ὄπα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἕζεο δὴ τηνεῖ καὶ τῷ χαρίεντι Πριήπῳ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εὔχεʼ ἀποστέρξαι τοὺς Δάφνιδός με πόθους,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κεὐθὺς ἐπιρρέξειν χίμαρον καλόν. ἢν δʼ ἀνανεύσῃ,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῦδε τυχὼν ἐθέλω τρισσὰ θύη τελέσαι·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ῥέξω γὰρ δαμάλαν, λάσιον τράγον, ἄρνα τὸν ἴσχω"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "4.18", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σακίταν. ἀίοι δʼ εὐμενέως ὁ θεός."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "5.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λῇς ποτὶ τᾶν Νυμφᾶν διδύμοις αὐλοῖσιν ἀεῖσαι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "5.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἁδύ τί μοι; κἠγὼ πακτίδʼ ἀειράμενος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "5.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀρξεῦμαί τι κρέκειν, ὁ δὲ βουκόλος ἄμμιγα θελξεῖ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "5.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Δάφνις, κηροδέτῳ πνεύματι μελπόμενος."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "5.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐγγὺς δὲ στάντες λασίας δρυὸς ἄντρου ὄπισθεν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "5.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Πᾶνα τὸν αἰγιβάταν ὀρφανίσωμες ὕπνου."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "6.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἆ δειλαῖε τὺ Θύρσι, τί τὸ πλέον, εἰ καταταξεῖς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "6.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δάκρυσι διγλήνους ὦπας ὀδυρόμενος;"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "6.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἴχεται ἁ χίμαρος, τὸ καλὸν τέκος, οἴχετʼ ἐς Ἅιδαν·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "6.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τραχὺς γὰρ χαλαῖς ἀμφεπίαξε λύκος."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "6.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἱ δὲ κύνες κλαγγεῦντι· τί τὸ πλέον, ἁνίκα τήνας"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "6.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὀστίον οὐδὲ τέφρα λείπεται οἰχομένας;"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "7.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νήπιον υἱὸν ἔλειπες, ἐν ἁλικίᾳ δὲ καὶ αὐτός,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "7.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Εὐρύμεδον τύμβου τοῦδε θανὼν ἔτυχες."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "7.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σοὶ μὲν ἕδρα θείοισι μετʼ ἀνδράσι· τὸν δὲ πολῖται"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "7.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τιμασεῦντι, πατρὸς μνώμενοι ὡς ἀγαθοῦ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "8.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἦλθε καὶ ἐς Μίλητον ὁ τοῦ Παιήονος υἱός,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "8.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἰητῆρι νόσων ἀνδρὶ συνοισόμενος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "8.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Νικίᾳ, ὅς μιν ἐπʼ ἦμαρ ἀεὶ θυέεσσιν ἱκνεῖται,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "8.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ τόδʼ ἀπʼ εὐώδους γλύψατʼ ἄγαλμα κέδρου,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "8.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἠετίωνι χάριν γλαφυρᾶς χερὸς ἄκρον ὑποστὰς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "8.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μισθόν· ὁ δʼ εἰς ἔργον πᾶσαν ἀφῆκε τέχνην."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "9.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ξεῖνε, Συρακόσιός τοι ἀνὴρ τόδʼ ἐφίεται Ὄρθων·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "9.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χειμερίας μεθύων μηδαμὰ νυκτὸς ἴοις."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "9.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ γὰρ ἐγὼ τοιοῦτον ἔχω πότμον· ἀντὶ δὲ πολλᾶς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "9.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πατρίδος ὀθνείαν κεῖμαι ἐφεσσάμενος."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "10.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ὑμῖν τοῦτο θεαὶ κεχαρισμένον ἐννέα πάσαις"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "10.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὤγαλμα Ξενοκλῆς θῆκε τὸ μαρμάρινον,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "10.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μουσικός· οὐχ ἑτέρως τις ἐρεῖ. σοφίῃ δʼ ἐπὶ τῇδε"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "10.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἶνον ἔχων Μουσέων οὐκ ἐπιλανθάνεται."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "11.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Εὐσθένεος τὸ μνῆμα· φυσιγνώμων ὁ σοφιστής,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "11.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δεινὸς ἀπʼ ὀφθαλμοῦ καὶ τὸ νόημα μαθεῖν."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "11.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εὖ μιν ἔθαψαν ἑταῖροι ἐπὶ ξείνης ξένον ὄντα·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "11.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χὑμνοθέτης αὐτοῖς δαιμονίως φίλος ἦν."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "11.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πάντων ὧν ἐπέοικεν ἔχειν τεθνεὼς ὁ σοφιστὴς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "11.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καίπερ ἄκικυς ἐὼν εἶχʼ ἄρα κηδεμόνας."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "12.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Δημομέλης ὁ χορηγός, ὁ τὸν τρίποδʼ ὦ Διόνυσε"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "12.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ σὲ τὸν ἥδιστον θεῶν μακάρων ἀναθείς,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "12.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μέτριος ἦν ἐν πᾶσι, χορῷ δʼ ἐκτήσατο νίκην"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "12.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀνδρῶν, καὶ τὸ καλὸν καὶ τὸ προσῆκον ὁρῶν."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "13.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἡ Κύπρις οὐ πάνδημος. ἱλάσκεο τὴν θεὸν εἰπὼν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "13.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐρανίην, ἁγνῆς ἄνθεμα Χρυσογόνης"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "13.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἴκῳ ἐν Ἀμφικλέους, ᾧ καὶ τέκνα καὶ βίον εἶχε"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "13.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ξυνόν. ἀεὶ δέ σφιν λώιον εἰς ἔτος ἦν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "13.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐκ σέθεν ἀρχομένοις ὦ πότνια· κηδόμενοι γὰρ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "13.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀθανάτων αὐτοὶ πλεῖον ἔχουσι βροτοί."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "14.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἀστοῖς καὶ ξείνοισιν ἴσον νέμει ἥδε τράπεζα·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "14.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θεὶς ἀνελοῦ ψήφου πρὸς λόγον ἐρχομένης."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "14.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄλλός τις πρόφασιν λεγέτω· τὰ δʼ ὀθνεῖα Κάικος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "14.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χρήματα καὶ νυκτὸς βουλομένοις ἀριθμεῖ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "15.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γνώσομαι, εἴ τι νέμεις ἀγαθοῖς πλέον, ἢ καὶ ὁ δειλὸς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "15.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐκ σέθεν ὡσαύτως ἶσον ὁδοιπόρʼ ἔχει."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "15.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χαιρέτω οὗτος ὁ τύμβος\" ἐρεῖς \"ἐπεὶ Εὐρυμέδοντος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "15.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κεῖται τῆς ἱερῆς κοῦφος ὑπὲρ κεφαλῆς."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "16.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἡ παῖς ᾤχετʼ ἄωρος ἐν ἑβδόμῳ ἥδʼ ἐνιαυτῷ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "16.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἰς Ἀίδην πολλοῖς ἡλικίης προτέρη,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "16.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δειλαίη, ποθέουσα τὸν εἰκοσάμηνον ἀδελφόν,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "16.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νήπιον ἀστόργου γευσάμενον θανάτου."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "16.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰαῖ ἐλεινὰ παθοῦσα Περιστερί, ὡς ἐν ἑτοίμῳ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "16.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀνθρώποις δαίμων θῆκε τὰ λυγρότατα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "17.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θᾶσαι τὸν ἀνδριάντα τοῦτον ὦ ξένε"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "17.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σπουδᾷ, καὶ λέγʼ ἐπὴν ἐς οἶκον ἔνθῃς·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "17.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἀνακρέοντος εἰκόνʼ εἶδον ἐν Τέῳ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "17.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῶν πρόσθʼ εἴ τι περισσὸν ᾠδοποιοῦ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "17.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "προσθεὶς δὲ χὥτι τοῖς νέοισιν ἅδετο,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "17.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐρεῖς ἀτρεκέως ὅλον τὸν ἄνδρα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἅ τε φωνὰ Δώριος χὡνὴρ ὁ τὰν κωμῳδίαν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εὑρὼν Ἐπίχαρμος."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὦ Βάκχε, χάλκεόν νιν ἀντʼ ἀλαθινοῦ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "̔́τὶν ὧδʼ ἀνέθηκαν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοὶ Συρακόσσαις ἐνίδρυνται πεδωρισταὶ πόλει,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἷʼ ἀνδρὶ πολίτᾳ·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σωρὸν γὰρ εἶχε ῥημάτων μεμναμένοις"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "̔́τελεῖν ἐπίχειρα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλὰ γὰρ πὸτ τὰν ζόαν τοῖς πᾶσιν εἶπε χρήσιμα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "18.10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μεγάλα χάρις αὐτῷ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "19.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ὁ μουσοποιὸς ἐνθάδʼ Ἱππῶναξ κεῖται."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "19.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἰ μὲν πονηρός, μὴ ποτέρχευ τῷ τύμβῳ·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "19.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἰ δʼ ἐσσὶ κρήγυός τε καὶ παρὰ χρηστῶν,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "19.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θαρσέων καθίζευ, κἢν θέλῃς ἀπόβριξον."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "20.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ὁ μικκὸς τόδʼ ἔτευξε τᾷ Θραΐσσᾳ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "20.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Μήδειος τὸ μνᾶμʼ ἐπὶ τᾷ ὁδῷ κἠπέγραψε Κλείτας."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "20.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἑξεῖ τὰν χάριν ἁ γυνὰ ἀντὶ τήνων,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "20.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὧν τὸν κοῦρον ἔθρεψε. τί μάν; ἔτι χρησίμα καλεῖται."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "21.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἀρχίλοχον καὶ στᾶθι καὶ εἴσιδε τὸν πάλαι ποιητὰν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "21.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸν τῶν ἰάμβων, οὗ τὸ μυρίον κλέος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "21.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "διῆλθε κἠπὶ νύκτα καὶ πρὸς ἀῶ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "21.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἦ ῥά νιν αἱ Μοῖσαι καὶ ὁ Δάλιος ἠγάπευν Ἀπόλλων,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "21.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς ἐμμελής τʼ ἔγεντο κἠπιδέξιος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "21.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔπεά τε ποιεῖν πρὸς λύραν τʼ ἀείδειν."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸν τοῦ Ζανὸς ὅδʼ ὗμιν υἱὸν ὡνὴρ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸν λεοντομάχαν, τὸν ὀξύχειρα,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πρᾶτος τῶν ἐπάνωθε μουσοποιῶν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Πείσανδρος συνέγραψεν ὡκ Καμίρου"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "χὥσους ἐξεπόνασεν εἶπʼ ἀέθλους."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῦτον δʼ αὐτὸν ὁ δᾶμος, ὡς σάφʼ εἰδῇς,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔστασʼ ἐνθάδε χάλκεον ποιήσας"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "22.8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλοῖς μησὶν ὄπισθε κἠνιαυτοῖς."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "23.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Καἴ τις ἀνὴρ αἰτεῖται ἐπαγροσύνην τε καὶ ὄλβον,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "23.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐξ ἁλὸς ᾧ ζωή, τὰ δὲ δίκτυα κείνῳ ἄροτρα,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "23.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σφάζων ἀκρόνυχος ταύτῃ θεῷ ἱερὸν ἰχθύν,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "23.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὃν λεῦκον καλέουσιν, ὁ γὰρ φιερώτατος ἄλλων,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "23.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καί κε λίνα στήσαιτο καὶ ἐξερύσαιτο θαλάσσης"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "23.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἔμπλεα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μῆτερ ἐμή, τίφθʼ ὧδε φίλον κατὰ θυμὸν ἰάπτεις"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐκπάγλως ἀχέουσα, τὸ πρὶν δέ τοι οὐκέτʼ ἔρευθος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σώζετʼ ἐπὶ ῥεθέεσσι; τί μοι τόσον ἠνίησαι;"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἦ ῥʼ ὅτι ἄλγεα πάσχει ἀπείριτα φαίδιμος υἱὸς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀνδρὸς ὑπʼ οὐτιδανοῖο, λέων ὡσείθʼ ὑπὸ νεβροῦ;"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὤμοι ἐγώ, τί νυ δή με θεοὶ τόσον ἠτίμησαν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀθάνατοι; τί νύ μʼ ὧδε κακῇ γονέες τέκον αἴσῃ;"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δύσμορος, ἥτʼ ἐπεὶ ἀνδρὸς ἀμύμονος ἐς λέχος ἦλθον,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τὸν μὲν ἐγὼ τίεσκον ἴσον φαέεσσιν ἐμοῖσιν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἠδʼ ἔτι νῦν σέβομαί τε καὶ αἰδέομαι κατὰ θυμόν·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῦ δʼ οὔτις γένετʼ ἄλλος ἀποτμότερος ζωόντων,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδὲ τόσων σφετέρῃσιν ἐγεύσατο φροντίσι κηδέων."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σχέτλιος, ὃς τόξοισιν, ἅ οἱ πόρεν αὐτὸς Ἀπόλλων"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἠέ τινος Κηρῶν ἢ Ἐριννύος αἰνὰ βέλεμνα,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παῖδας ἑοὺς κατέπεφνε καὶ ἐκ φίλον εἵλετο θυμὸν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μαινόμενος κατὰ οἶκον, ὁ δʼ ἔμπλεος ἔσκε φόνοιο."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοὺς μὲν ἐγὼ δύστηνος ἐμοῖς ἴδον ὀφθαλμοῖσι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.18", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "βαλλομένους ὑπὸ πατρί· τὸ δʼ οὐδʼ ὄναρ ἤλυθεν ἄλλῳ·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.19", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδέ σφιν δυνάμην ἀδινὸν καλέουσιν ἀρῆξαι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.20", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μητέρʼ ἑήν, ἐπεὶ ἐγγὺς ἀνίκητον κακὸν ἦεν."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.21", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς δʼ ὄρνις ὀδύρηται ἐπὶ σφετέροισι νεοσσοῖς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.22", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὀλλυμένοις, οὕστʼ αἰνὸς ὄφις ἔτι νηπιάχοντας"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.23", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θάμνοις ἐν πυκινοῖσι κατεσθίει· ἡ δὲ κατʼ αὐτοὺς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.24", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πωτᾶται κλάζουσα μάλα λιγὺ πότνια μήτηρ,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.25", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδʼ ἄρʼ ἔχει τέκνοισιν ἐπαρκέσαι· ἦ ῥά οἱ αὐτῇ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.26", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἆσσον ἴμεν μέγα τάρβος ἀμειλίκτοιο πελώρου·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.27", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὣς ἐγὼ αἰνοτόκεια φίλον γόνον αἰάζουσα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.28", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μαινομένοισι πόδεσσι δόμον κάτα πολλὸν ἐφοίτων."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.29", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὥς γʼ ὄφελον μετὰ παισὶν ἅμα θνήσκουσα καὶ αὐτὴ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.30", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κεῖσθαι φαρμακόεντα διʼ ἥπατος ἰὸν ἔχουσα,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.30a", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ καὶ σοῖς ἀγανοῖσιν ὑπαὶ βελέεσσι δαμῆναι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.31", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἄρτεμι θηλυτέρῃσι μέγα κρείουσα γυναιξί."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.32", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῷ χʼ ἡμᾶς κλαύσαντε φίλῃς ἐπὶ χερσὶ τοκῆες"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.33", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλοῖς σὺν κτερέεσσι πυρῆς ἐπέβησαν ὁμοίης,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.34", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καί κεν ἕνα χρύσειον ἐς ὀστέα κρωσσὸν ἁπάντων"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.35", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "λέξαντες κατέθαψαν, ὅθι πρῶτον γενόμεσθα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.36", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νῦν δʼ οἱ μὲν Θήβην ἱπποτρόφον ἐνναίουσιν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.37", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἀονίου πεδίοιο βαθεῖαν βῶλον ἀροῦντες·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.38", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτὰρ ἐγὼ Τίρυνθα κατὰ κραναὴν πόλιν Ἥρης"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.39", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πολλοῖσιν δύστηνος ἰάπτομαι ἄλγεσιν ἦτορ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.40", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰεὶ ὁμῶς· δακρύων δὲ πάρεστί μοι οὐδʼ ἴʼ ἐρωή."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.41", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλὰ πόσιν μὲν ὁρῶ παῦρον χρόνον ὀφθαλμοῖσιν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.42", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἴκῳ ἐν ἡμετέρῳ· πολέων δὲ οἱ ἔργον ἑτοῖμον"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.43", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μόχθων, τοὺς ἐπὶ γαῖαν ἀλώμενος ἠδὲ θάλασσαν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.44", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μοχθίζει πέτρης ὅγʼ ἔχων νόον ἠὲ σιδήρου"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.45", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καρτερὸν ἐν στήθεσσι· σὺ δʼ ἠύτε λείβεται ὕδωρ,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.46", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νύκτας τε κλαίουσα καὶ ἐκ Διὸς ἤμαθʼ ὁπόσσα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.47", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄλλος μὰν οὐκ ἄν τις ἐυφρήναι με παραστὰς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.48", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κηδεμόνων· οὐ γάρ σφε δόμων κατὰ τεῖχος ἐέργει."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.49", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ λίην πάντες γε πέρην πιτυώδεος Ἰσθμοῦ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.50", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ναίουσʼ, οὐδέ μοί ἐστι πρὸς ὅντινά κε βλέψασα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.51", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἷα γυνὴ πανάποτμος ἀναψύξαιμι φίλον κῆρ,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.52", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νόσφι γε δὴ Πύρρης συνομαίμονος· ἡ δὲ καὶ αὐτὴ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.53", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀμφὶ πόσει σφετέρῳ πλέον ἄχνυται Ἰφικλῆι,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.54", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σῷ υἱεῖ· πάντων γὰρ ὀϊζυρώτατα τέκνα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.55", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γείνασθαί σε θεῷ τε καὶ ἀνέρι θνητῷ ἔολπα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.56", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὣς ἄρʼ ἔφη· τὰ δέ οἱ θαλερώτερα δάκρυα μήλων"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.57", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κόλπον ἐς ἱμερόεντα κατὰ βλεφάρων ἐχέοντο,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.58", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μνησαμένῃ τέκνων τε καὶ ὧν μετέπειτα τοκήων."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.59", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὡς δʼ αὔτως δακρύοισι παρήια λεύκʼ ἐδίαινεν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.60", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἀλκμήνη· βαρὺ δʼ ἥγε καὶ ἐκ θυμοῦ στενάχουσα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.61", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μύθοισιν πυκινοῖσι φίλην νυὸν ὧδε μετηύδα·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.62", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δαιμονίη παίδων, τί νύ τοι φρεσὶν ἔμπεσε τοῦτο"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.63", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πευκαλίμῃς; πῶς ἄμμʼ ἐθέλεις ὀροθυνέμεν ἄμφω"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.64", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κήδεʼ ἄλαστα λέγουσα; τὰ δʼ οὐ νῦν πρῶτα κέκλαυται."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.65", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἢ οὐχ ἅλις, οἷς ἐχόμεσθα τὸ δεύτατον αἰεὶ ἐπʼ ἦμαρ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.66", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γινομένοις; μάλα μέν γε φιλοθρηνής κέ τις εἴη,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.67", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅστις ἀριθμήσειεν………"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.67a", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "……ἐφʼ ἡμετέροις ἀχέεσσι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.68", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θάρσει. οὐ τοιῆσδʼ ἐκυρήσαμεν ἐκ θεοῦ αἴσης."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.69", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ δʼ αὐτὴν ὁρόω δε, φίλον τέκος, ἀτρύτοισιν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.70", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἄλγεσι μοχθίζουσαν. ἐπιγνώμων δέ τοί εἰμι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.71", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀσχαλάαν, ὅτε δή γε καὶ εὐφροσύνης κόρος ἐστί."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.72", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καί σε μάλʼ ἐκπάγλως ὀλοφύρομαι ἠδʼ ἐλεαίρω,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.73", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὕνεκεν ἡμετέροιο λυγροῦ μετὰ δαίμονος ἔσχες,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.74", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅσθʼ ἡμῖν ἐφύπερθε κάρης βαρὺς αἰωρεῖται."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.75", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἴστω γὰρ Κούρη τε καὶ εὐέανος Δημήτηρ,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.76", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἅς κε μέγα βλαφθείς τις ἑκὼν ἐπίορκον ὀμόσσῃ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.77", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δυσμενέων, μηδέν δε χερειότερον φρεσὶν ᾗσι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.78", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "στέργειν ἢ εἴ πέρ μοι ὑπὲκ νηδυίοφιν ἦλθες"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.79", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καί μοι τηλυγέτη ἐνὶ δώμασι παρθένος ἦσθα."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.80", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδʼ αὐτήν γέ νυ πάμπαν ἔολπά δε τοῦτό γε λήθειν."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.81", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῷ μηδʼ ἐξείπῃς πότʼ, ἐμὸν θάλος, ὥς σευ ἀκηδέω,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.82", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μηδʼ εἴ κʼ ἠυκόμου Νιόβης πυκινώτερα κλαίω."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.83", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οὐδὲν γὰρ νεμεσητὸν ὑπὲρ τέκνου γοάασθαι"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.84", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "μητέρι δυσπαθέοντος· ἐπεὶ δέκα μῆνας ἔκαμνον"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.85", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πρὶν ἤπερ τʼ ἰδέειν μιν, ἐμῷ ὑπὸ ἥπατʼ ἔχουσα,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.86", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καί με πυλάρταο σχεδὸν ἤγαγεν Αἰδωνῆος·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.87", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὧδέ ἑ δυστοκέουσα κακὰς ὠδῖνας ἀνέτλην."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.88", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νῦν δέ μοι οἴχεται υἱὸς ἐπʼ ἀλλοτρίης νέον ἆθλον"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.89", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐκτελέων· οὐδʼ οἶδα δυσάμμορος, εἴτε μιν αὐτὸν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.90", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐνθάδε νοστήσανθʼ ὑποδέξομαι, εἴτε καὶ οὐκί."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.91", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πρὸς δʼ ἔτι μʼ ἐπτοίησε διὰ γλυκὺν αἰνὸς ὄνειρος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.92", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὕπνον· δειμαίνω δὲ παλίγκοτον ὄψιν ἰδοῦσα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.93", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐκπάγλως, μή μοί τι τέκνοις ἀποθύμιον ἔρδοι."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.94", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἴσατο γάρ μοι ἔχων μακέλην εὐεργέα χερσὶ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.95", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παῖς ἐμὸς ἀμφοτέρῃσι, βίη Ἡρακληείη·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.96", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῇ μεγάλην ἐλάχαινε δεδεγμένος ὡς ἐπὶ μισθῷ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.97", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τάφρον τηλεθάοντος ἐπʼ ἐσχατιῇ τινος ἀγροῦ,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.98", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "γυμνὸς ἄτερ χλαίνης τε καὶ εὐμίτροιο χιτῶνος."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.99", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτὰρ ἐπειδὴ παντὸς ἀφίκετο πρὸς τέλος ἔργου"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.100", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καρτερὸν οἰνοφόροιο πονεύμενος ἕρκος ἀλωῆς,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.101", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἤτοι ὁ λίστρον ἔμελλεν ἐπὶ προύχοντος ἐρείσας"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.102", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀνδήρου καταδῦναι ἃ καὶ πάρος εἵματα ἕστο·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.103", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐξαπίνης δʼ ἀνέλαμψεν ὑπὲρ καπέτοιο βαθείης"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.104", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πῦρ ἄμοτον, περὶ δʼ αὐτὸν ἀθέσφατος εἱλεῖτο φλόξ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.105", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτὰρ ὅγʼ αἰὲν ὄπισθε θοοῖς ἀνεχάζετο ποσσίν,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.106", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἐκφυγέειν μεμαὼς ὀλοὸν μένος Ἡφαίστοιο·"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.107", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰεὶ δὲ προπάροιθεν ἑοῦ χροὸς ἠύτε γέρρον"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.108", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "νώμασκεν μακέλην· περὶ δʼ ὄμμασιν ἔνθα καὶ ἔνθα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.109", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πάπταινεν, μὴ δή μιν ἐπιφλέξῃ δήιον πῦρ."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.110", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τῷ μὲν ἀοσσῆσαι λελιημένος, ὥς μοι ἔικτο,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.111", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἰφικλέης μεγάθυμος ἐπʼ οὔδεϊ κάππεσʼ ὀλισθὼν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.112", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πρὶν ἐλθεῖν, οὐδʼ ὀρθὸς ἀναστῆναι δύνατʼ αὖτις,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.113", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀλλʼ ἀστεμφὲς ἔκειτο, γέρων ὡσείτʼ ἀμενηνός,"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.114", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὅντε καὶ οὐκ ἐθέλοντα βιήσατο γῆρας ἀτερπὲς"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.115", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καππεσέειν, κεῖται δʼ ὅγʼ ἐπὶ χθονὸς ἔμπεδον αὐτοῦ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.116", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "εἰς ὅ κε τις χειρός μιν ἀνειρύσσῃ παριόντων"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.117", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰδεσθεὶς ὄπιδα τρομερὴν πολιοῖο γενείου."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.118", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὣς ἐν γῇ λελίαστο σακεσπάλος Ἰφικλείης."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.119", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αὐτὰρ ἐγὼ κλαίεσκον ἀμηχανέοντας ὁρῶσα"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.120", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παῖδας ἐμούς, μέχρι δή μοι ἀπέσσυτο νήδυμος ὕπνος"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.121", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὀφθαλμῶν, ἠὼς δὲ παραυτίκα φαινόλις ἦλθε."}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.122", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "τοῖα, φίλη, μοι ὄνειρα διὰ φρένας ἐπτοίησαν"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.123", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "παννυχίῃ· τὰ δὲ πάντα πρὸς Εὐρυσθῆα τρέποιτο"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.124", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "οἴκου ἀφʼ ἡμετέροιο, γένοιτο δὲ μάντις ἐκείνῳ"}
{"urn": "theocritus-bucolic.epigrammata", "edition": "perseus-grc2", "locus": "24.125", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θυμὸς ἐμός, μηδʼ ἄλλο παρὲκ τελέσειέ τι δαίμων."}
