{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.7", "text": "ρέσεως Ἑρμογένοῦς."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.8", "text": "VI. Γεωργίου Πλήθωνος συντομὴ περὶ τινων με- 542."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.9", "text": "ρῶν τῆς ῥητορικῆς."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.10", "text": "VII. Ματθαίου τοῦ Καμαριώτου ἐπιτομὴ τῆς ῥη- 599."}
{"urn": "ocr.walz_rhetores_v6", "source": "ocr", "license": "PD", "edition": "migne-ocr-qwen36", "locus": "walz_rhetores_v6_0007.11", "text": "τορικῆς."}
