{"urn": "sphaerus.fragmenta", "edition": "qwen36-persaeus_svf1_arnim-ocr", "locus": "persaeus_svf1_arnim_0196.11", "source": "ocr", "license": "PD", "text": "περιττὸν εἶναι, μὴ μέλλοντά γε προσφέρεσθαι.“", "corrections": ["dehyphenation"]}
