{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "21", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἄμμον θαλάσσης κοφίνῳ ζητεῖς μετρεῖν,"}
