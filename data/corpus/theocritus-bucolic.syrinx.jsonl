{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "1", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Οὐδενὸς εὐνάτειρα Μακροπτολέμοιο δὲ μάτηρ"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "2", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "μαίας ἀντιπέτροιο θοὸν τέκεν ἰθυντῆρα,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "3", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "οὐχὶ Κεράσταν ὅν ποτε θρέψατο ταυροπάτωρ,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "4", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ἀλλ᾽ ου πειλιπὲς αἶθε πάρος φρένα τέρμα σάκους,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "5", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "οὔνομ᾽ Ὅλον, δίζων, ὃς τᾶς μέροπος πόθον"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "6", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "κούρας γηρυγόνας ἔχε τᾶς ἀνεμώδεος,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "7", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ὃς Μοίσᾳ λιγὺ πᾶξεν ἰοστεφάνῳ"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "8", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ἕλκος, ἄγαλμα πόθοιο πυρισμαράγου,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "9", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ὃς σβέσεν ἀνορέαν ἰσαυδέα"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "10", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "παπποφόνου Τυρίας τ᾽ ἐξήλασεν."}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "11", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ᾧ τόδε τυφλοφόρων ἐρατόν"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "12", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "πῆμα Πάρις θέτο Σιμιχίδας·"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "13", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ψυχὰν ᾇ, βροτοβάμων,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "14", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "στήτας οἶστρε Σαέττας,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "15", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "κλωποπάτωρ, ἀπάτωρ,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "16", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "λαρνακόγυιε, χαρείς"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "17", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ἁδὺ μελίσδοις"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "18", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "ἔλλοπι κούρᾳ,"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "19", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Καλλιόπᾳ"}
{"urn": "theocritus-bucolic.syrinx", "edition": "1st1K-grc1", "locus": "20", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "νηλεύστῳ."}
