{"urn": "hermias-history.fragmenta", "edition": "qwen36-aristobulus_fhg3", "locus": "aristobulus_fhg3_0044.8", "source": "ocr", "license": "PD", "text": "27. ΕΜΠΕΔΟΚΛΗΣ."}
