{"urn": "hymni-homerici.in-dioscuros", "edition": "perseus-grc2", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Κάστορα καὶ Πολυδεύκἐ ἀείσεο, Μοῦσα λίγεια,"}
{"urn": "hymni-homerici.in-dioscuros", "edition": "perseus-grc2", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Τυνδαρίδας, οἳ Ζηνὸς Ὀλυμπίου ἐξεγένοντο·"}
