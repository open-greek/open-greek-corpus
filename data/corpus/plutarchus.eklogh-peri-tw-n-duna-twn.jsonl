{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "11", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Εἰς ὕδωρ σπείρεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "12", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἀκίνητα κίνεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "13", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἀκίχητα διώκεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "14", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Σίδηρον πλεῖν διδάσκεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "15", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Δελφῖνα νήχεσθαι διδάσκεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "16", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Ἡλίῳ φῶς δανείζεις."}
{"urn": "plutarchus.eklogh-peri-tw-n-duna-twn", "edition": "1st1K-grc1", "locus": "17", "source": "first1k", "license": "CC-BY-SA-4.0", "text": "Κύματα μετρεῖς."}
