{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "1", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Ἆρες ὑπερμενέτα, βρισάρματε, χρυσεοπήληξ,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "2", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ὀβριμόθυμε, φέρασπι, πολισσόε, χαλκοκορυστά,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "3", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καρτερόχειρ, ἀμόγητε, δορισθενές, ἕρκος Ὀλύμπου,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "4", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "Νίκης εὐπολέμοιο πάτερ, συναρωγὲ Θέμιστος,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "5", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἀντιβίοισι τύραννε, δικαιοτάτων ἀγὲ φωτῶν,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "6", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἠνορέης σκηπτοῦχε, πυραυγέα κύκλον ἑλίσσων"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "7", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "αἰθέρος ἑπταπόροις ἐνὶ τείρεσιν, ἔνθα σε πῶλοι"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "8", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ζαφλεγέες τριτάτης ὑπὲρ ἄντυγος αἰὲν ἔχουσι·"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "9", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "κλῦθι, βροτῶν ἐπίκουρε, δοτὴρ εὐθαρσέος ἥβης,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "10", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "πρηὺ καταστίλβων σέλας ὑψόθεν ἐς βιότητα"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "11", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "ἡμετέρην καὶ κάρτος ἀρήιον, ὥς κε δυναίμην"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "12", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "σεύασθαι κακότητα πικρὴν ἀπʼ ἐμοῖο καρήνου,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "13", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "καὶ ψυχῆς ἀπατηλὸν ὑπογνάμψαι φρεσὶν ὁρμήν,"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "14", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "θυμοῦ αὖ μένος ὀξὺ κατισχέμεν, ὅς μʼ ἐρέθῃσι"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "15", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "φυλόπιδος κρυερῆς ἐπιβαινέμεν· ἀλλὰ σὺ θάρσος"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "16", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δός, μάκαρ, εἰρήνης τε μένειν ἐν ἀπήμοσι θεσμοῖς"}
{"urn": "hymni-homerici.in-martem", "edition": "perseus-grc2", "locus": "17", "source": "perseus", "license": "CC-BY-SA-4.0", "text": "δυσμενέων προφυγόντα μόθον Κῆράς τε βιαίους."}
